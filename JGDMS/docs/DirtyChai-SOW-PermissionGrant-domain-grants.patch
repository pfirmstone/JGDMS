+import java.io.ByteArrayOutputStream;
+import java.io.DataOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.net.URL;
+import java.net.URLClassLoader;
+import java.nio.file.Files;
+import java.security.CodeSource;
+import java.security.Permission;
+import java.security.Principal;
+import java.security.ProtectionDomain;
+import java.security.cert.Certificate;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.jar.JarEntry;
+import java.util.jar.JarOutputStream;
+import javax.security.auth.x500.X500Principal;
+import org.apache.river.api.security.PermissionGrant;
+import org.apache.river.api.security.PermissionGrantBuilder;
+
+/**
+ * @test
+ * @summary A dynamic grant (PermissionGrantBuilder.CODEBASE_DOMAIN) to a class
+ *          applies to each ProtectionDomain of the codebase of its ClassLoader,
+ *          including a jar whose first class is loaded after the grant, and
+ *          to no other: not to a location outside the codebase, nor to a
+ *          second loader over identical jars. A domain rebuilt by a
+ *          DomainCombiner is covered, a domain at a codebase location with a
+ *          different identity is not, and the grant honours its principals.
+ * @author Claude Sonnet 5.5 -- AI-authored under AI_POLICY.md 4.1 (Zone T)
+ * @run main CodebaseDomainGrantTest
+ */
+public class CodebaseDomainGrantTest {
+
+    private static final Principal[] NONE = new Principal[0];
+    private static final Permission PERM = new RuntimePermission("codebase.domain.grant");
+    private static final List<String> failures = new ArrayList<>();
+
+    public static void main(String[] args) throws Exception {
+        File dir = Files.createTempDirectory("codebase-domain").toFile();
+        URL jarA = jar(dir, "a.jar", "codebasetest.ProxyA");
+        URL jarB = jar(dir, "b.jar", "codebasetest.ProxyB");
+        URL outside = new File(dir, "outside.jar").toURI().toURL();
+
+        URLClassLoader loader = new URLClassLoader(new URL[]{jarA, jarB},
+                ClassLoader.getPlatformClassLoader());
+        Class<?> a = loader.loadClass("codebasetest.ProxyA");
+        PermissionGrant g = PermissionGrantBuilder.newBuilder()
+                .principals(NONE).permissions(new Permission[]{PERM})
+                .context(PermissionGrantBuilder.CODEBASE_DOMAIN).clazz(a).build();
+        check(g.implies(a.getProtectionDomain()), "A");
+
+        Class<?> b = loader.loadClass("codebasetest.ProxyB"); // after the grant
+        check(g.implies(b.getProtectionDomain()), "B, loaded after the grant");
+        check(!g.implies(new ProtectionDomain(new CodeSource(outside, (Certificate[]) null),
+                null, loader, NONE)), "location outside the codebase");
+
+        URLClassLoader other = new URLClassLoader(new URL[]{jarA, jarB},
+                ClassLoader.getPlatformClassLoader());
+        check(!g.implies(other.loadClass("codebasetest.ProxyA").getProtectionDomain()), "second loader A");
+        check(!g.implies(other.loadClass("codebasetest.ProxyB").getProtectionDomain()), "second loader B");
+
+        Principal p = new X500Principal("CN=Rebuilt");
+        ProtectionDomain pb = b.getProtectionDomain();
+        check(g.implies(new ProtectionDomain(pb.getCodeSource(), null, loader, new Principal[]{p})),
+                "domain rebuilt by a combiner");
+
+        check(!g.implies(loader, NONE), "a ClassLoader alone");
+
+        PermissionGrant forP = PermissionGrantBuilder.newBuilder()
+                .principals(new Principal[]{p}).permissions(new Permission[]{PERM})
+                .context(PermissionGrantBuilder.CODEBASE_DOMAIN).clazz(a).build();
+        check(!forP.implies(a.getProtectionDomain()), "principal required, none held");
+        check(forP.implies(new ProtectionDomain(a.getProtectionDomain().getCodeSource(), null,
+                loader, new Principal[]{p})), "principal held");
+
+        for (File f : dir.listFiles()) f.delete();
+        dir.delete();
+        if (!failures.isEmpty()) {
+            throw new RuntimeException(failures.size() + " failure(s): " + failures);
+        }
+    }
+
+    private static URL jar(File dir, String file, String name) throws Exception {
+        File f = new File(dir, file);
+        try (JarOutputStream out = new JarOutputStream(new FileOutputStream(f))) {
+            out.putNextEntry(new JarEntry(name.replace('.', '/') + ".class"));
+            out.write(emptyClass(name));
+            out.closeEntry();
+        }
+        return f.toURI().toURL();
+    }
+
+    /** Class file for: public class name {} (version 52, no constructor). */
+    private static byte[] emptyClass(String name) throws Exception {
+        ByteArrayOutputStream bo = new ByteArrayOutputStream();
+        DataOutputStream o = new DataOutputStream(bo);
+        o.writeInt(0xCAFEBABE);
+        o.writeShort(0);
+        o.writeShort(52);
+        o.writeShort(5);
+        o.writeByte(1); o.writeUTF(name.replace('.', '/'));
+        o.writeByte(7); o.writeShort(1);
+        o.writeByte(1); o.writeUTF("java/lang/Object");
+        o.writeByte(7); o.writeShort(3);
+        o.writeShort(0x0021);
+        o.writeShort(2);
+        o.writeShort(4);
+        o.writeShort(0);
+        o.writeShort(0);
+        o.writeShort(0);
+        o.writeShort(0);
+        return bo.toByteArray();
+    }
+
+    private static void check(boolean ok, String what) {
+        if (!ok) failures.add(what);
+    }
+}
