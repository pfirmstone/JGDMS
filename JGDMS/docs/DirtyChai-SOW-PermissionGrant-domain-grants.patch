+
+package org.apache.river.api.security;
+
+import au.zeus.jdk.net.Uri;
+import java.security.CodeSource;
+import java.security.DigestCodeSource;
+import java.security.cert.Certificate;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * The identity of a {@link CodeSource}: location {@link Uri}, signers and, 
+ * when the CodeSource is a {@link DigestCodeSource}, the content digest.
+ * <p>
+ * {@code CodeSource.equals} is deliberately not used here, the identity
+ * of a grant must not depend on a lookup, and the grant implementations in
+ * JGDMS, which run on a stock JDK, compare the same three things.
+ * 
+ * @since 27
+ */
+final class CodeSourceKey {
+
+    /**
+     * Creates the identity of a CodeSource.
+     * 
+     * @param cs the CodeSource.
+     * @return the identity, or null if cs is null or has no location Uri.
+     * Callers must treat null as not implied (fail closed).
+     */
+    static CodeSourceKey of(CodeSource cs) {
+        if (cs == null) return null;
+        Uri uri = (Uri) cs.getUriLocation();
+        if (uri == null) return null;
+        Certificate[] certs = cs.getCertificates();
+        List<Certificate> signers = certs == null || certs.length == 0 
+                ? Collections.<Certificate>emptyList()
+                : Collections.unmodifiableList(Arrays.asList(certs));
+        String alg = null;
+        byte[] dig = null;
+        if (cs instanceof DigestCodeSource dcs) {
+            alg = dcs.getDigestAlgorithm();
+            dig = dcs.getDigest(); // a defensive copy.
+        }
+        return new CodeSourceKey(uri, signers, alg, dig);
+    }
+
+    final Uri uri;
+    private final List<Certificate> signers;
+    private final String digestAlgorithm;
+    private final byte[] digest;
+    private final int hash;
+
+    private CodeSourceKey(Uri uri, List<Certificate> signers, 
+            String digestAlgorithm, byte[] digest) {
+        this.uri = uri;
+        this.signers = signers;
+        this.digestAlgorithm = digestAlgorithm;
+        this.digest = digest;
+        int h = uri.hashCode();
+        h = 31 * h + signers.hashCode();
+        h = 31 * h + (digestAlgorithm != null ? digestAlgorithm.hashCode() : 0);
+        h = 31 * h + Arrays.hashCode(digest);
+        this.hash = h;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (o == this) return true;
+        if (!(o instanceof CodeSourceKey k)) return false;
+        if (hash != k.hash) return false;
+        if (!uri.equals(k.uri)) return false;
+        if (!signers.equals(k.signers)) return false;
+        if (digestAlgorithm == null ? k.digestAlgorithm != null 
+                : !digestAlgorithm.equals(k.digestAlgorithm)) return false;
+        return Arrays.equals(digest, k.digest);
+    }
+
+    @Override
+    public int hashCode() {
+        return hash;
+    }
+
+    @Override
+    public String toString() {
+        return "CodeSourceKey[" + uri + ", signers=" + signers.size()
+                + (digest != null ? ", digest=" + digestAlgorithm : "") + "]";
+    }
+}
