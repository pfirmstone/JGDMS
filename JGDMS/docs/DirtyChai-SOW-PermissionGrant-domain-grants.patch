+
+import java.net.URL;
+import java.security.CodeSource;
+import java.security.DigestCodeSource;
+import java.security.Permission;
+import java.security.Principal;
+import java.security.PublicKey;
+import java.security.cert.Certificate;
+import java.util.ArrayList;
+import java.util.List;
+import org.apache.river.api.security.PermissionGrant;
+import org.apache.river.api.security.PermissionGrantBuilder;
+
+/**
+ * @test
+ * @summary signedBy, codeBase + signedBy and digest + signedBy grants must
+ *          enforce their signers against unsigned, other-signer and null code
+ *          sources, must never be implied by a ClassLoader alone, and a digest
+ *          grant must ignore the location. Unsigned code used to throw
+ *          NullPointerException from CertificateGrant.implies(CodeSource, Principal[]).
+ *          An unparseable codeBase URI must fail closed.
+ * @author Claude Sonnet 5.5 -- AI-authored under AI_POLICY.md 4.1 (Zone T)
+ * @run main GrantSignerTest
+ */
+public class GrantSignerTest {
+
+    private static final Principal[] NONE = new Principal[0];
+    private static final Permission PERM = new RuntimePermission("grant.signer.test");
+    private static final byte[] DIGEST_A = {1, 2, 3, 4};
+    private static final byte[] DIGEST_B = {9, 8, 7, 6};
+    private static final String ALG = "SHA-256";
+    private static final List<String> failures = new ArrayList<>();
+
+    public static void main(String[] args) throws Exception {
+        Certificate alice = new Fake("alice");
+        Certificate bob = new Fake("bob");
+        URL a = new URL("http://localhost/a.jar");
+        URL b = new URL("http://localhost/b.jar");
+
+        PermissionGrant signed = signedBy(alice, bob);
+        check(signed.implies(new CodeSource(a, new Certificate[]{alice, bob}), NONE), "all signers");
+        check(!signed.implies(new CodeSource(a, new Certificate[]{alice}), NONE), "one signer of two");
+        check(!signed.implies(new CodeSource(a, new Certificate[]{bob}), NONE), "other signer");
+        check(!signed.implies(new CodeSource(a, (Certificate[]) null), NONE), "unsigned, no NPE");
+        check(!signed.implies((CodeSource) null, NONE), "null code source");
+        check(!signed.implies(GrantSignerTest.class.getClassLoader(), NONE), "class loader alone");
+        check(signedBy().implies(new CodeSource(a, (Certificate[]) null), NONE), "no signers required");
+
+        PermissionGrant cb = codeBase("http://localhost/a.jar", alice);
+        check(cb.implies(new CodeSource(a, new Certificate[]{alice}), NONE), "codeBase+signedBy match");
+        check(!cb.implies(new CodeSource(a, (Certificate[]) null), NONE), "codeBase, unsigned");
+        check(!cb.implies(new CodeSource(a, new Certificate[]{bob}), NONE), "codeBase, other signer");
+        check(!cb.implies(new CodeSource(b, new Certificate[]{alice}), NONE), "other location");
+        check(!cb.implies(GrantSignerTest.class.getClassLoader(), NONE), "codeBase+signedBy, class loader");
+
+        try {
+            codeBase("http://[bad/a.jar");
+            check(false, "unparseable codeBase URI must fail closed");
+        } catch (SecurityException expected) {
+            // fail closed
+        }
+
+        PermissionGrant d = digest(DIGEST_A, alice);
+        CodeSource same = new DigestCodeSource("http://localhost/a.jar", new Certificate[]{alice}, ALG, DIGEST_A);
+        CodeSource moved = new DigestCodeSource("http://localhost/moved/z.jar", new Certificate[]{alice}, ALG, DIGEST_A);
+        CodeSource otherDigest = new DigestCodeSource("http://localhost/a.jar", new Certificate[]{alice}, ALG, DIGEST_B);
+        CodeSource otherSigner = new DigestCodeSource("http://localhost/a.jar", new Certificate[]{bob}, ALG, DIGEST_A);
+        CodeSource unsigned = new DigestCodeSource("http://localhost/a.jar", (Certificate[]) null, ALG, DIGEST_A);
+        check(d.implies(same, NONE), "digest+signedBy match");
+        check(d.implies(moved, NONE), "digest ignores location");
+        check(!d.implies(otherDigest, NONE), "other digest");
+        check(!d.implies(otherSigner, NONE), "digest, other signer");
+        check(!d.implies(unsigned, NONE), "digest, unsigned");
+        check(!d.implies(new CodeSource(a, new Certificate[]{alice}), NONE), "plain CodeSource, same URL");
+        check(digest(DIGEST_A).implies(moved, NONE), "digest without signers");
+        check(!d.implies(GrantSignerTest.class.getClassLoader(), NONE), "digest, class loader");
+
+        if (!failures.isEmpty()) {
+            throw new RuntimeException(failures.size() + " failure(s): " + failures);
+        }
+    }
+
+    private static PermissionGrant signedBy(Certificate... certs) {
+        return PermissionGrantBuilder.newBuilder()
+                .certificates(certs, new String[]{"alias"})
+                .permissions(new Permission[]{PERM}).principals(NONE)
+                .context(PermissionGrantBuilder.CODESOURCE_CERTS).build();
+    }
+
+    private static PermissionGrant codeBase(String uri, Certificate... certs) {
+        PermissionGrantBuilder bld = PermissionGrantBuilder.newBuilder()
+                .permissions(new Permission[]{PERM}).principals(NONE)
+                .context(PermissionGrantBuilder.URI).uri(uri);
+        if (certs.length > 0) bld.certificates(certs, new String[]{"alias"});
+        return bld.build();
+    }
+
+    private static PermissionGrant digest(byte[] digest, Certificate... certs) {
+        PermissionGrantBuilder bld = PermissionGrantBuilder.newBuilder()
+                .permissions(new Permission[]{PERM}).principals(NONE)
+                .digest(ALG, digest).context(PermissionGrantBuilder.DIGEST);
+        if (certs.length > 0) bld.certificates(certs, new String[]{"alias"});
+        return bld.build();
+    }
+
+    private static void check(boolean ok, String what) {
+        if (!ok) failures.add(what);
+    }
+
+    /** Certificates are equal if their encodings are. */
+    private static final class Fake extends Certificate {
+        private static final long serialVersionUID = 1L;
+        private final byte[] encoded;
+        Fake(String id) {
+            super("fake");
+            encoded = id.getBytes(java.nio.charset.StandardCharsets.UTF_8);
+        }
+        @Override public byte[] getEncoded() { return encoded.clone(); }
+        @Override public void verify(PublicKey key) { }
+        @Override public void verify(PublicKey key, String sigProvider) { }
+        @Override public String toString() { return "Fake"; }
+        @Override public PublicKey getPublicKey() { return null; }
+    }
+}
