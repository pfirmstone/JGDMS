+    private static final boolean BULK = Boolean.getBoolean("jeri.bulk");
+
+    /**
+     * Sends a large array directly, in ration-sized pieces of at most 0xFFFF
+     * bytes, without copying it into the fragment buffer, and waits once
+     * for the last piece to be written (the caller's array must not change
+     * until then).  The fragment buffer must be empty.
+     */
+    private void writeBulk(byte[] b, int off, int len) throws IOException {
+        java.util.ArrayList<IOFuture> futures = new java.util.ArrayList<>();
+        try {
+            while (len > 0) {
+                IOFuture future;
+                synchronized (sessionLock) {
+                    while (!session.outRationInfinite
+                            && session.getOutRation() < 1
+                            && sessionDown == null
+                            && session.getOutState() == Session.OPEN)
+                    {
+                        try {
+                            sessionLock.wait();
+                        } catch (InterruptedException e) {
+                            String message = "request I/O interrupted";
+                            session.setDown(message, e);
+                            throw new IOException(message, e);
+                        }
+                    }
+                    ensureOpen();
+                    if (fakeOKtoWrite) {
+                        return;
+                    }
+                    int toSend = Math.min(len, 0xFFFF);
+                    if (!session.outRationInfinite) {
+                        toSend = Math.min(toSend, session.getOutRation());
+                        session.setOutRation(session.getOutRation() - toSend);
+                    }
+                    session.setPartialDeliveryStatus(true);
+                    boolean open = session.getOutState() == Session.IDLE;
+                    int op = Mux.DATA | (open ? Mux.DATA_OPEN : 0);
+                    ByteBuffer piece = ByteBuffer.wrap(b, off, toSend);
+                    future = mux.futureSendData(op, session.sessionID, piece);
+                    if (open) {
+                        session.setOutState(Session.OPEN);
+                        session.setInState(Session.OPEN);
+                    }
+                    off += toSend;
+                    len -= toSend;
+                }
+                futures.add(future);
+            }
+        } finally {
+            IOException failure = null;
+            for (IOFuture f : futures) {
+                try {
+                    waitForIO(f);
+                } catch (IOException e) {
+                    if (failure == null) failure = e;
+                }
+            }
+            if (failure != null) {
+                throw failure;
+            }
+        }
+    }
