<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus</groupId>
        <artifactId>jgdms</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>au.net.zeus.jgdms</groupId>
    <artifactId>jgdms-platform</artifactId>
    <packaging>jar</packaging>

    <name>Module :: JGDMS Jini Platform</name>
    <description>JGDMS Jini Platform, Policy provider, SecurityManager, Constraints and Proxy preparation</description>
    <organization>
        <name>The Apache Software Foundation</name>
        <url>http://www.apache.org/</url>
    </organization>
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <high.scale.lib.version>1.0.6</high.scale.lib.version>
        <!-- Added to the surefire argLine; empty unless the dirtychai-patch
             profile below is active. -->
        <jgdms.dirtychai.args></jgdms.dirtychai.args>
    </properties>

    <dependencies>
        <!--<dependency>
          <groupId>com.boundary</groupId>
          <artifactId>high-scale-lib</artifactId>
          <version>${high.scale.lib.version}</version>
        </dependency>-->
        <dependency>
            <groupId>au.net.zeus.pack200-ex-openjdk</groupId>
            <artifactId>Pack200-ex-openjdk</artifactId>
            <version>${pack200.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-collections</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-activation-parameters</artifactId>
            <version>${project.version}</version>
        </dependency> 
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.annotation</artifactId>
            <version>${osgi.annotation.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.core</artifactId>
            <version>4.3.1</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.util.tracker</artifactId>
            <version>1.5.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
              <groupId>biz.aQute.bnd</groupId>
              <artifactId>bnd-maven-plugin</artifactId>
              <executions>
                    <execution>
                        <goals>
                            <goal>bnd-process</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin> 
             <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                        <release>21</release>
                        <encoding>UTF-8</encoding>
                        <meminitial>128m</meminitial>
                        <maxmem>1024m</maxmem>
                    </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Permit tests to install a SecurityManager on JDK 17+
                         (JEP 411). This only *allows* setSecurityManager; no SM
                         is installed unless a test does so explicitly. Needed by
                         AgentDelegationCeilingTest.

                         The tests run against whichever copy of the shared
                         org.apache.river.api.security classes the JDK loads:
                         a JDK that bundles its own in java.base uses those, any
                         other uses the copies of this module from the class
                         path.  Tests use public (and, for this module's own
                         subclasses, protected) API of the shared classes only,
                         and skip what the loaded copy does not have.  Nothing is
                         patched into java.base unless the dirtychai-patch
                         profile below is active. -->
                    <argLine>-Djava.security.manager=allow ${jgdms.dirtychai.args}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <excludeFilterFile>findbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>
        </plugins>
    </reporting>

    <profiles>
        <!-- Optional, off by default: run the tests against the classes of a
             newer JDK than the one running Maven (a DirtyChai build that is
             newer than the installed one), given as a directory of class files:
                 mvn -pl jgdms-platform test -Djgdms.dirtychai.patch=DIR
             DIR holds org/apache/river/api/security/*.class and what they use
             (java/security/DigestCodeSource.class and so on).  It is patched
             over java.base, and the package is exported to the tests.  More
             than one directory may be given, separated by the path separator.
             Give -Djgdms.conformance.jdkClasses=DIR2 as well to have
             BundledCopyConformanceTest compare against the classes in DIR2
             (the runtime image is read otherwise, which shows nothing of a
             patch). -->
        <profile>
            <id>dirtychai-patch</id>
            <activation>
                <property>
                    <name>jgdms.dirtychai.patch</name>
                </property>
            </activation>
            <properties>
                <jgdms.dirtychai.args>--patch-module=java.base=${jgdms.dirtychai.patch} --add-exports java.base/org.apache.river.api.security=ALL-UNNAMED</jgdms.dirtychai.args>
            </properties>
        </profile>
    </profiles>
</project>
