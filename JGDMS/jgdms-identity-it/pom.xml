<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus</groupId>
        <artifactId>jgdms</artifactId>
        <version>4.0.0-SNAPSHOT</version>
    </parent>

    <groupId>au.net.zeus.jgdms</groupId>
    <artifactId>jgdms-identity-it</artifactId>
    <packaging>jar</packaging>

    <name>Module :: JGDMS server identity tests</name>
    <description>Tests only, not shipped: the codebase provider's server identity
        probe and pin over real SSL JERI, with the SPIFFE principal of jgdms-lib-dl.
        jgdms-jeri cannot have the provider (it would change how every JERI test
        resolves proxies) or jgdms-lib-dl (which depends on it) on its own test
        classpath.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <spire.agent.socket>${project.build.directory}/spire/agent.sock</spire.agent.socket>
    </properties>

    <dependencies>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-jeri</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-jeri</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-pref-class-loader</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-lib-dl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <!-- The ambient-identity tests need a SPIRE agent listening before their JVM
                 starts (DirtyChai reads the Workload API socket when a JVM starts): a mock
                 agent is spawned here, and stops when the test JVM exits or after 30 min. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>mock-spire-agent</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <target>
                                <java classname="net.jini.jeri.ssl.MockSpireAgentLauncher" classpathref="maven.test.classpath" fork="true" spawn="true">
                                    <arg value="${spire.agent.socket}"/>
                                    <arg value="1800"/>
                                </java>
                                <waitfor maxwait="60" maxwaitunit="second" timeoutproperty="mock.spire.agent.absent">
                                    <available file="${spire.agent.socket}"/>
                                </waitfor>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Their client identity is the ambient SPIFFE worker: they run in the
                             execution below, in a JVM given the mock agent's socket. -->
                        <exclude>**/ServerIdentityPinProbeTest.java</exclude>
                        <exclude>**/ResolvePinsTheProbedIdentityTest.java</exclude>
                        <exclude>**/CodebaseFreeProxyIdentityTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>ambient-worker-fork</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override">
                                <exclude>none</exclude>
                            </excludes>
                            <includes combine.self="override">
                                <include>**/ServerIdentityPinProbeTest.java</include>
                                <include>**/ResolvePinsTheProbedIdentityTest.java</include>
                                <include>**/CodebaseFreeProxyIdentityTest.java</include>
                            </includes>
                            <forkCount>1</forkCount>
                            <reuseForks>true</reuseForks>
                            <argLine>-Dspiffe.workload.socket=${spire.agent.socket}</argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
