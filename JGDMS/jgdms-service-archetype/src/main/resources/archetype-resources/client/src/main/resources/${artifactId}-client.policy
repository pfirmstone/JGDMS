/*
 * Security policy — ${serviceName}Service Client
 */

grant codebase "file:${dollar}{client.codebase}/-" {
    permission java.net.SocketPermission "*:1024-", "connect,resolve";
    permission java.net.SocketPermission "224.0.1.85:4160", "connect,accept";
    permission java.net.MulticastSocketPermission "224.0.1.85:4160", "connect,accept";
    permission java.io.FilePermission "${dollar}{config.dir}/-", "read";
    permission java.util.PropertyPermission "*", "read";
    permission java.lang.RuntimePermission "getClassLoader";
    permission java.lang.RuntimePermission "createClassLoader";
};

/* Downloaded proxy classes — minimal permissions. */
grant codebase "file:${dollar}{dl.codebase}/-" {
    permission java.net.SocketPermission "*:1024-", "connect,resolve";
    permission java.util.PropertyPermission "*", "read";
};

/* Jini lookup service download classes (Reggie's registrar proxy).
 * Downloaded/mobile code — a proxy must never be granted AllPermission.
 * Minimal set mirrors deploy/policy/host1-lookup.policy's grant to the
 * identical jar (file:${dollar}{jgdms.lib-dl}/*). */
grant codebase "file:${dollar}{reggie.dl.codebase}/-" {
    permission org.apache.river.api.io.DeSerializationPermission "ATOMIC";
    permission org.apache.river.api.io.DeSerializationPermission "ENTRY";
    permission java.lang.RuntimePermission "accessClassInPackage.com.sun.proxy";
};

/* JGDMS platform and infrastructure — full trust. */
grant codebase "file:${dollar}{jgdms.lib.dir}/-" {
    permission java.security.AllPermission;
};
