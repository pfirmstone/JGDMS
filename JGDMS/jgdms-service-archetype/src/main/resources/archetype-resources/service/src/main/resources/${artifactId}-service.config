/*
 * Jini Configuration — ${serviceName}Service
 *
 * This configuration file is read by ${serviceName}ServiceImpl via
 * ConfigurationProvider.getInstance(configArgs, classLoader).
 *
 * Component: ${component}
 *
 * Two exporter configurations are shown:
 *
 *   (A) Plain TCP (default, insecure — good for development / localhost):
 *       Uses TcpServerEndpoint and AtomicILFactory without constraints.
 *       This is what JiniServiceParameters uses when no serverExporter entry
 *       is present, so for the plain TCP case you can simply omit the entry.
 *
 *   (B) SSL/TLS (recommended for production):
 *       Uses SslServerEndpoint and AtomicILFactory with
 *         Integrity.YES + ClientAuthentication.YES
 *       set as minimum constraints on every inbound call.
 *
 * Uncomment one of the serverExporter blocks below; the other is shown for
 * reference.  Adjust keystore paths and passwords for your deployment.
 */

import ${package}.${serviceName}Service;
import net.jini.constraint.*;
import net.jini.core.constraint.*;
import net.jini.jeri.*;
import net.jini.jeri.ssl.SslServerEndpoint;
import net.jini.jeri.tcp.TcpServerEndpoint;
import net.jini.core.discovery.LookupLocator;

${component} {

    /*
     * -------------------------------------------------------------------------
     * (A) Plain TCP exporter — no authentication, no encryption.
     *     Use during development on a trusted network only.
     *     This is equivalent to the built-in default; you may omit this entry
     *     to use the same default provided by JiniServiceParameters.
     * -------------------------------------------------------------------------
     */
    serverExporter =
        new BasicJeriExporter(
            TcpServerEndpoint.getInstance(0),
            new AtomicILFactory(
                null,                                   /* no constraints */
                null,                                   /* no permission class */
                ${serviceName}Service.class
            ),
            false,   /* enableDGC */
            true     /* keepAlive */
        );

    /*
     * -------------------------------------------------------------------------
     * (B) SSL/TLS exporter — integrity + mutual authentication required.
     *     Uncomment this block (and comment out block A above) to enable TLS.
     *
     * serverExporter =
     *     new BasicJeriExporter(
     *         SslServerEndpoint.getInstance(0),
     *         new AtomicILFactory(
     *             new BasicMethodConstraints(
     *                 new InvocationConstraints(
     *                     new InvocationConstraint[]{
     *                         Integrity.YES,
     *                         ClientAuthentication.YES
     *                     },
     *                     null
     *                 )
     *             ),
     *             null,
     *             ${serviceName}Service.class
     *         ),
     *         false,
     *         true
     *     );
     * -------------------------------------------------------------------------
     */

    /*
     * Discovery: join the public ("") multicast group.
     * Add unicast locators or additional groups as needed.
     */
    initialLookupGroups = new String[]{ "" };

    initialLookupLocators = new LookupLocator[0];

    initialLookupAttributes = new net.jini.core.entry.Entry[0];

    // Uncomment to preserve ServiceID across restarts:
    // persistenceDirectory = "/var/lib/${artifactId}/service";
}
