<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus</groupId>
        <artifactId>jgdms</artifactId>
        <version>3.1.1-SNAPSHOT</version>
    </parent>

    <groupId>au.net.zeus.jgdms</groupId>
    <artifactId>jgdms-service-archetype</artifactId>
    <packaging>maven-archetype</packaging>

    <name>Module :: JGDMS Service Maven Archetype</name>
    <description>
        Maven archetype for generating a new JGDMS service project with the
        standard 4-module layout (api, dl, service, client), pre-wired with
        AbstractSmartProxy, AbstractJiniService, DefaultJiniServiceParameters,
        ServiceDiscoveryHelper, and example .config and .policy files.

        Usage:
          mvn archetype:generate \
            -DarchetypeGroupId=au.net.zeus.jgdms \
            -DarchetypeArtifactId=jgdms-service-archetype \
            -DarchetypeVersion=3.1.1-SNAPSHOT \
            -DgroupId=com.example \
            -DartifactId=my-service \
            -DserviceName=MyService \
            -Dcomponent=com.example.myservice
    </description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-archetype-plugin</artifactId>
                <!-- 3.3.0 fixes CVE-2024-47197: archetype:integration-test could
                     package ~/.m2/settings.xml (credentials) into the artifact. -->
                <version>3.3.0</version>
            </plugin>
        </plugins>
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>3.3.0</version>
            </extension>
        </extensions>
    </build>
</project>
