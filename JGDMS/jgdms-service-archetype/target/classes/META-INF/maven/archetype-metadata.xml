<?xml version="1.0" encoding="UTF-8"?>
<!--
  Archetype descriptor for the JGDMS service archetype.

  Custom properties:
    serviceName  - PascalCase name for the service (e.g., "Hello", "Calculator").
                   Used to name interfaces and classes: ${serviceName}Service,
                   ${serviceName}ServiceProxy, ${serviceName}ServiceImpl, etc.
                   Default: "Hello"
    component    - Jini configuration component name (reverse-DNS string).
                   Default: "${package}"
    jgdmsVersion - Version of JGDMS to depend on.
                   Default: "3.1.1-SNAPSHOT"
-->
<archetype-descriptor
        xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0
                            https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
        name="jgdms-service-archetype"
        partial="false">

    <requiredProperties>
        <!-- PascalCase service name, e.g. "Hello", "Calculator", "OrderManager" -->
        <requiredProperty key="serviceName">
            <defaultValue>Hello</defaultValue>
        </requiredProperty>
        <!-- Jini configuration component name -->
        <requiredProperty key="component">
            <defaultValue>${package}</defaultValue>
        </requiredProperty>
        <!-- JGDMS dependency version -->
        <requiredProperty key="jgdmsVersion">
            <defaultValue>3.1.1-SNAPSHOT</defaultValue>
        </requiredProperty>
    </requiredProperties>

    <!--
      Root fileset: the parent pom.xml that ties the four modules together.
    -->
    <fileSets>
        <fileSet filtered="true" encoding="UTF-8">
            <directory></directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>
    </fileSets>

    <modules>

        <!--
          ${artifactId}-api  — service interface module.
          Contains only the @Remote service interface that both the client
          and the service implementation depend on.
        -->
        <module id="${rootArtifactId}-api" dir="api" name="${rootArtifactId}-api">
            <fileSets>
                <fileSet filtered="true" encoding="UTF-8">
                    <directory></directory>
                    <includes>
                        <include>pom.xml</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/main/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
            </fileSets>
        </module>

        <!--
          ${artifactId}-dl  — download-side (client-facing) classes.
          Contains the @AtomicSerial smart proxy and its constrainable variant.
          These classes are downloaded to client JVMs from the service codebase.
        -->
        <module id="${rootArtifactId}-dl" dir="dl" name="${rootArtifactId}-dl">
            <fileSets>
                <fileSet filtered="true" encoding="UTF-8">
                    <directory></directory>
                    <includes>
                        <include>pom.xml</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/main/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
            </fileSets>
        </module>

        <!--
          ${artifactId}-service  — server-side service implementation.
          Extends AbstractJiniService; contains the business logic and the
          Jini/JGDMS wrapper.  Includes .config and .policy resource files.
        -->
        <module id="${rootArtifactId}-service" dir="service" name="${rootArtifactId}-service">
            <fileSets>
                <fileSet filtered="true" encoding="UTF-8">
                    <directory></directory>
                    <includes>
                        <include>pom.xml</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/main/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" encoding="UTF-8">
                    <directory>src/main/resources</directory>
                    <includes>
                        <include>*.config</include>
                        <include>*.policy</include>
                    </includes>
                </fileSet>
            </fileSets>
        </module>

        <!--
          ${artifactId}-client  — client application.
          Uses ServiceDiscoveryHelper for single-line service discovery.
          Includes .config and .policy resource files.
        -->
        <module id="${rootArtifactId}-client" dir="client" name="${rootArtifactId}-client">
            <fileSets>
                <fileSet filtered="true" encoding="UTF-8">
                    <directory></directory>
                    <includes>
                        <include>pom.xml</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/main/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" encoding="UTF-8">
                    <directory>src/main/resources</directory>
                    <includes>
                        <include>*.config</include>
                        <include>*.policy</include>
                    </includes>
                </fileSet>
            </fileSets>
        </module>

    </modules>

</archetype-descriptor>
