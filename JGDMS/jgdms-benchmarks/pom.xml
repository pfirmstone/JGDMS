<!--
  Policy-overhead micro-benchmarks for DirtyChai + ConcurrentPolicyFile.

  Deliberately standalone: this project has no <parent> and is not listed in the
  JGDMS root pom, so it does not inherit the root's release 8 target or its
  marshal-delegate annotation processor (which would stop the JMH generator
  from running). Build it on its own:

      mvn -f jgdms-benchmarks/pom.xml package

  See README.md for how to run it and how to read the results.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>au.net.zeus.jgdms.bench</groupId>
    <artifactId>jgdms-benchmarks</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>JGDMS policy-overhead benchmarks</name>

    <modules>
        <module>workload</module>
        <module>harness</module>
        <module>serialization</module>
    </modules>

    <properties>
        <!-- Virtual threads and the JMH VIRTUAL executor need 21+. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jmh.version>1.37</jmh.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.6.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
