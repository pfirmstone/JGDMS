<!--
  Serialization-format benchmarks: JERI with AtomicSerial over Java Object
  Serialization (JOSS) versus over JGDMS-STD-006 DER.

  Depends on the installed jgdms-jeri 4.0.0-SNAPSHOT (and transitively
  jgdms-der and jgdms-platform), so `mvn install` the JGDMS root first.
  jgdms-der is compiled for release 25, so this module needs a JDK 25+ to
  compile and to run; the JERI tier additionally needs a JDK that still
  permits permission checks (DirtyChai), see README.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus.jgdms.bench</groupId>
        <artifactId>jgdms-benchmarks</artifactId>
        <version>4.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>jgdms-bench-serialization</artifactId>
    <packaging>jar</packaging>
    <name>JGDMS serialization-format benchmarks</name>

    <properties>
        <!-- jgdms-der's class files are release 25. -->
        <maven.compiler.release>25</maven.compiler.release>
        <jgdms.version>4.0.0-SNAPSHOT</jgdms.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-jeri</artifactId>
            <version>${jgdms.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-rmi-tls</artifactId>
            <version>${jgdms.version}</version>
            <exclusions>
                <!-- its META-INF/services names RMIClassLoader providers that are not on the benchmark class path -->
                <exclusion>
                    <groupId>au.net.zeus.jgdms</groupId>
                    <artifactId>jgdms-resources</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>serialization-benchmarks</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <!-- jgdms-der registers its MarshalFactoryProvider via ServiceLoader. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
