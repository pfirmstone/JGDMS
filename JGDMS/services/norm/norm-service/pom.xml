<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus.jgdms</groupId>
        <artifactId>norm</artifactId>
        <version>4.0.0-SNAPSHOT</version>
    </parent>

    <groupId>au.net.zeus.jgdms.norm</groupId>
    <artifactId>norm-service</artifactId>
    <packaging>jar</packaging>

    <name>Module :: Norm Service Implementation</name>

    <dependencies>
        <dependency>
            <groupId>au.net.zeus.jgdms.norm</groupId>
            <artifactId>norm-dl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-activation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
		
       	<dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>service-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          Test-only: provides the DER MarshalFactoryProvider (ServiceLoader
          discovered by net.jini.io.MarshalledInstance) so that tests can
          actually decode MarshallingFormat.ATOMIC_DER-tagged instances at
          test-runtime, exercising the same write sites converted from
          AtomicMarshalledInstance (JOSS) to DER by commit 221fe251c
          (ClientLeaseWrapper, EventType, JoinState). Not referenced by any
          compiled symbol in main or test sources, purely a runtime SPI
          provider (same pattern as reggie-dl's EntryRepDerFormatTest).
        -->
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-der</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
              <groupId>biz.aQute.bnd</groupId>
              <artifactId>bnd-maven-plugin</artifactId>
              <executions>
                    <execution>
                        <goals>
                            <goal>bnd-process</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- DER-format round-trip tests build real MarshalledInstance
                             payloads, whose marshalling machinery can consult
                             RMIClassLoader for codebase annotations. Use the default
                             RMI class provider so the test JVM needs no
                             preferred-class-loader SPI on its classpath (same pattern
                             as outrigger-service/EntryFieldIndexTest and
                             reggie-dl/EntryRepDerFormatTest). -->
                        <java.rmi.server.RMIClassLoaderSpi>default</java.rmi.server.RMIClassLoaderSpi>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <excludeFilterFile>findbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>
        </plugins>
    </reporting>
</project>
