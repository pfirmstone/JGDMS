<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus.jgdms</groupId>
        <artifactId>mercury</artifactId>
        <version>4.0.0-SNAPSHOT</version>
    </parent>

    <groupId>au.net.zeus.jgdms.mercury</groupId>
    <artifactId>mercury-service</artifactId>
    <packaging>jar</packaging>

    <name>Module :: Mercury Service Implementation</name>

    <dependencies>
        <dependency>
            <groupId>au.net.zeus.jgdms.mercury</groupId>
            <artifactId>mercury-dl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-activation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          Test-only: provides the DER MarshalFactoryProvider (ServiceLoader
          discovered by net.jini.io.MarshalledInstance) so that tests can
          actually encode/decode MarshallingFormat.ATOMIC_DER-tagged
          instances at test-runtime, exercising the same
          AtomicMarshalledInstance->DER write sites this module's main
          sources use (EventID, EventWriter, MailboxImpl,
          ServiceRegistration). Not referenced by any compiled symbol in
          main or test sources, purely a runtime SPI provider; jgdms-der
          itself requires a JDK 25+ runtime (release 25), so tests that pull
          it in must run under such a JVM (same requirement as jgdms-der's
          own test suite).

          Two tests additionally exercise the legacy JOSS
          org.apache.river.api.io.AtomicMarshalledInstance path
          (EventIDDerFormatTest#atomicSerialPathRoundTripsSourceViaNestedDer,
          EventWriterDerFormatTest#legacyJossEncodedEventStillDecodesViaEventReader),
          which performs a SerializablePermission subclass check via
          Permission.checkGuard/AccessController.doPrivileged; on a vanilla
          (SecurityManager-removed, JEP 486) JDK 24 or newer, e.g. this machine's
          default java-25-openjdk, that throws "SecurityException: checking
          permissions is not supported". Run the test phase with a
          SecurityManager-capable JDK (e.g. DirtyChai's build/*/images/jdk as
          JAVA_HOME) and -Djava.security.manager=allow to exercise those two
          tests; every other test in this module runs fine on a vanilla JDK.
        -->
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-der</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
              <groupId>biz.aQute.bnd</groupId>
              <artifactId>bnd-maven-plugin</artifactId>
              <executions>
                    <execution>
                        <goals>
                            <goal>bnd-process</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                    <!--
                      net.jini.io.MarshalledInstance's JOSS/annotateClass path
                      touches java.rmi.server.RMIClassLoader, which eagerly
                      ServiceLoader-discovers an RMIClassLoaderSpi at class-init
                      time; the test classpath can pull in a
                      META-INF/services entry for
                      net.jini.loader.pref.PreferredClassProvider without the
                      jgdms-pref-class-loader jar itself being present, which
                      fails the whole provider lookup. The JDK default
                      provider is sufficient for these in-JVM unit tests (same
                      pattern as reggie-dl, policy-service-dl, hello-world-api).
                    -->
                    <argLine>-Djava.rmi.server.RMIClassLoaderSpi=default</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <excludeFilterFile>findbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>
        </plugins>
    </reporting>
</project>
