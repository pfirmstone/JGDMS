/*
 * Jini Configuration -- Reggie, "der"-group instance
 *
 * This configuration file is read by RegistrarImpl via
 * ConfigurationProvider.getInstance(configArgs, classLoader).
 *
 * Component: org.apache.river.reggie
 *
 * Demonstrates one half of the two-group EntryRep/Item DER migration design
 * (see commit history for the AtomicMarshalledInstance->DER migration, and
 * EntryRep.java/Item.java javadoc): rather than a JVM-global flag, a client
 * migrates off legacy JOSS entry/service marshalling by discovering and
 * registering with a *separate* Reggie instance -- started with this config
 * -- that both (a) advertises itself in the "der" discovery group instead of
 * the legacy group, and (b) requires MarshallingFormat.ATOMIC_DER on its
 * exported endpoint. Every ConstrainableRegistrarProxy deserialized from
 * this server carries that requirement in its own constraints (derived from
 * the exported server's RemoteMethodControl.getConstraints()), so
 * RegistrarProxy/Template/Registration derive useDer=true from `this` at
 * every client-side EntryRep/Item construction site
 * (org.apache.river.reggie.proxy.Util#requiresDerFormat) -- and this
 * Reggie's own self-registered attributes use the useDerForEntries entry
 * below, read once at startup, for exactly the same decision made
 * server-side (RegistrarImpl doesn't go through a client proxy to register
 * itself).
 *
 * A client that only ever discovers/registers with "der"-group Reggies will
 * consistently use DER for every EntryRep/Item on the wire. A client
 * concurrently registered with both a "der" and a legacy (JOSS) Reggie
 * -- the normal case mid-migration, since JoinManager registers with every
 * discovered lookup service concurrently -- still gets the correct format
 * for each relationship, because the format is derived per-proxy/per-
 * registration, never globally: MarshalledWrapper.equals() (and therefore
 * EntryRep.equals()/matchEntry()) is a raw byte comparison of the wrapped
 * MarshalledInstance, so mixing formats between the two sides of a match
 * would otherwise silently break matching instead of failing loudly.
 *
 * There is no companion "legacy" config alongside this one: the pre-existing
 * behavior (no MarshallingFormat requirement on the exporter, useDerForEntries
 * defaulting to false) already IS the legacy/JOSS side, unchanged.
 *
 * NOTE: this is a payload-marshalling-format concern (EntryRep/Item field
 * encoding), layered on top of and orthogonal to qa/harness/configs/der's
 * existing "der" family of configs, which configures the JERI/SSL transport
 * wire protocol (STD-006) -- not addressed by this file.
 */

import net.jini.constraint.*;
import net.jini.core.constraint.*;
import net.jini.core.discovery.LookupLocator;
import net.jini.jeri.*;
import net.jini.jeri.ssl.SslServerEndpoint;
import net.jini.jeri.tcp.TcpServerEndpoint;
import org.apache.river.reggie.proxy.Registrar;

org.apache.river.reggie {

    /*
     * -------------------------------------------------------------------------
     * Exporter -- requires MarshallingFormat.ATOMIC_DER (in addition to the
     * usual Integrity.YES) on every inbound call. Any client whose proxy is
     * deserialized against this server therefore derives useDer=true for
     * every EntryRep/Item it constructs (RegistrarProxy/Template/Registration
     * via org.apache.river.reggie.proxy.Util#requiresDerFormat).
     *
     * Plain TCP is shown for brevity; swap in SslServerEndpoint for
     * production deployments, as the archetype/hello-world-service configs
     * do.
     * -------------------------------------------------------------------------
     */
    serverExporter =
        new BasicJeriExporter(
            TcpServerEndpoint.getInstance(0),
            new AtomicILFactory(
                new BasicMethodConstraints(
                    new InvocationConstraints(
                        new InvocationConstraint[]{
                            Integrity.YES,
                            MarshallingFormat.ATOMIC_DER
                        },
                        null
                    )
                ),
                null,                 /* no permission class */
                Registrar.class
            ),
            false,   /* enableDGC */
            true     /* keepAlive */
        );

    /*
     * -------------------------------------------------------------------------
     * Server-side mirror of the exporter requirement above: this Reggie's own
     * self-registered attributes (added via addLookupAttributes/
     * modifyLookupAttributes, and the initial self-registration performed by
     * start()) are constructed directly by RegistrarImpl rather than through
     * a client-side RegistrarProxy, so they need their own config-driven
     * format decision -- read once at startup, same pattern as
     * enableHttpsUnicast.
     * -------------------------------------------------------------------------
     */
    useDerForEntries = Boolean.TRUE;

    /*
     * -------------------------------------------------------------------------
     * Discovery: join the "der" group rather than the legacy public ("")
     * group, so that only clients deliberately migrating to the DER entry
     * format discover this instance.
     * -------------------------------------------------------------------------
     */
    initialLookupGroups = new String[]{ "der" };
    initialMemberGroups = new String[]{ "der" };

    initialLookupLocators = new LookupLocator[0];

    initialLookupAttributes = new net.jini.core.entry.Entry[0];

    // Uncomment to preserve ServiceID across restarts:
    // persistenceDirectory = "/var/lib/reggie/der";
}
