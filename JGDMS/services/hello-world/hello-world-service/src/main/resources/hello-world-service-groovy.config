/*
 * Groovy configuration — Hello World Service
 *
 * This is the Groovy equivalent of hello-world-service.config.
 * Groovy config syntax is more concise: no import statements,
 * no "new InvocationConstraint[]{...}" arrays, and you can
 * use Groovy closures and multi-line strings.
 *
 * To use Groovy config, ensure the groovy-config module is on the
 * classpath (re-enable it in JGDMS/pom.xml) and pass this file to
 * ConfigurationProvider.getInstance(configArgs, classLoader).
 *
 * Component: au.net.zeus.jgdms.hello
 */
import au.net.zeus.jgdms.api.hello.HelloService
import net.jini.core.constraint.Integrity
import net.jini.core.constraint.ClientAuthentication
import net.jini.core.constraint.InvocationConstraints
import net.jini.constraint.BasicMethodConstraints
import net.jini.jeri.BasicJeriExporter
import net.jini.jeri.DynamicILFactory
import net.jini.jeri.tcp.TcpServerEndpoint
import net.jini.jeri.ssl.SslServerEndpoint
import net.jini.admin.Administrable
import net.jini.admin.JoinAdmin
import org.apache.river.admin.DestroyAdmin

'au.net.zeus.jgdms.hello' {

    /*
     * (A) Plain TCP — development only.
     *     ZERO-CONFIG: no serverExporter entry.  The JiniServiceParameters default
     *     exporter is a BasicJeriExporter over TCP with net.jini.jeri.DynamicILFactory
     *     carrying the admin interfaces, so the exported dynamic-proxy stub is fat
     *     (Administrable/JoinAdmin/DestroyAdmin) with neither codegen nor config.
     */

    /*
     * (B) SSL/TLS — uncomment for production (block A above needs nothing).
     *     DynamicILFactory's last argument is the extra (admin) interface set.
     *
     * serverExporter = new BasicJeriExporter(
     *     SslServerEndpoint.getInstance(0),
     *     new DynamicILFactory(
     *         new BasicMethodConstraints(
     *             new InvocationConstraints([Integrity.YES, ClientAuthentication.YES], null)
     *         ),
     *         null,
     *         HelloService.classLoader,
     *         [Administrable, JoinAdmin, DestroyAdmin] as Class[]
     *     ),
     *     false, true
     * )
     */

    initialLookupGroups   = [''] as String[]
    initialLookupLocators = [] as net.jini.core.discovery.LookupLocator[]
    initialLookupAttributes = [] as net.jini.core.entry.Entry[]

    // persistenceDirectory = '/var/lib/jgdms/hello-world'
}
