/*
 * Jini Configuration — Hello World Service
 *
 * This configuration file is read by HelloWorldServiceImpl via
 * ConfigurationProvider.getInstance(configArgs, classLoader).
 *
 * Component: au.net.zeus.jgdms.hello
 *
 * Two exporter configurations are shown:
 *
 *   (A) Plain TCP (default, insecure — good for development / localhost):
 *       DEMONSTRATES ZERO-CONFIG ADMIN DISPATCH — no serverExporter entry at all.
 *       JiniServiceParameters' built-in default exporter is a BasicJeriExporter
 *       over TCP whose invocation-layer factory is net.jini.jeri.DynamicILFactory
 *       carrying the Jini admin interfaces (Administrable/JoinAdmin/DestroyAdmin),
 *       so the exported java.lang.reflect.Proxy stub carries them in both its cast
 *       set and its server dispatch set with neither code generation nor config.
 *
 *   (B) SSL/TLS (recommended for production):
 *       Uses SslServerEndpoint and net.jini.jeri.DynamicILFactory with
 *         Integrity.YES + ClientAuthentication.YES
 *       set as minimum constraints on every inbound call, and the same admin
 *       interfaces appended.
 *
 * DYNAMIC shape (JGDMS-STD-009 §6 shape 1): the exported stub IS the client proxy,
 * so its invocation-layer factory must append the non-Remote admin interfaces.
 * That is now done by the reusable net.jini.jeri.DynamicILFactory, which the
 * framework installs by default — so block (A) needs no serverExporter entry at
 * all.  Only a custom endpoint/constraints (block B) requires an explicit entry.
 */

import net.jini.constraint.*;
import net.jini.core.constraint.*;
import net.jini.jeri.*;
import net.jini.jeri.ssl.SslServerEndpoint;
import net.jini.jeri.tcp.TcpServerEndpoint;
import net.jini.core.discovery.LookupLocator;
import net.jini.admin.Administrable;
import net.jini.admin.JoinAdmin;
import org.apache.river.admin.DestroyAdmin;

au.net.zeus.jgdms.hello {

    /*
     * -------------------------------------------------------------------------
     * (A) Plain TCP exporter — no authentication, no encryption.
     *     Use during development on a trusted network only.
     *
     *     NO serverExporter entry: the framework default (a BasicJeriExporter over
     *     TCP with net.jini.jeri.DynamicILFactory carrying the admin interfaces)
     *     already produces the fat DYNAMIC stub.  This is the zero-config path.
     * -------------------------------------------------------------------------
     */

    /*
     * -------------------------------------------------------------------------
     * (B) SSL/TLS exporter — integrity + mutual authentication required.
     *     Uncomment this block to enable TLS (block A above needs nothing).
     *
     *     Prerequisites:
     *       - javax.net.ssl.keyStore  / javax.net.ssl.keyStorePassword set
     *       - javax.net.ssl.trustStore / javax.net.ssl.trustStorePassword set
     *     or configure via JAAS / loginContext.
     *
     *     DynamicILFactory's last argument is the extra-interface array: the Jini
     *     admin interfaces the exported stub must additionally carry (the same set
     *     the framework default supplies).
     *
     * serverExporter =
     *     new BasicJeriExporter(
     *         SslServerEndpoint.getInstance(0),
     *         new DynamicILFactory(
     *             new BasicMethodConstraints(
     *                 new InvocationConstraints(
     *                     new InvocationConstraint[]{
     *                         Integrity.YES,
     *                         ClientAuthentication.YES
     *                     },
     *                     null
     *                 )
     *             ),
     *             null,
     *             au.net.zeus.jgdms.api.hello.HelloService.class.getClassLoader(),
     *             new Class[]{ Administrable.class, JoinAdmin.class, DestroyAdmin.class }
     *         ),
     *         false,
     *         true
     *     );
     * -------------------------------------------------------------------------
     */

    /*
     * -------------------------------------------------------------------------
     * Discovery: join the public ("") multicast group.
     * Add unicast locators or additional groups as needed.
     * -------------------------------------------------------------------------
     */
    initialLookupGroups = new String[]{ "" };

    initialLookupLocators = new LookupLocator[0];

    /*
     * -------------------------------------------------------------------------
     * Attributes registered in lookup service(s).
     * -------------------------------------------------------------------------
     */
    initialLookupAttributes = new net.jini.core.entry.Entry[0];

    /*
     * -------------------------------------------------------------------------
     * Persistence: comment this in and set a writable directory to preserve
     * the ServiceID across restarts.
     * -------------------------------------------------------------------------
     */
    // persistenceDirectory = "/var/lib/jgdms/hello-world";
}
