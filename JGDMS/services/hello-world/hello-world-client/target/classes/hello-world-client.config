/*
 * Jini Configuration — Hello World Client
 *
 * This configuration file is read by HelloWorldClient via
 * ConfigurationProvider.getInstance(configArgs, classLoader).
 *
 * Component: au.net.zeus.jgdms.hello.client
 *
 * The client discovers the HelloService via multicast discovery and
 * imposes outbound constraints (Integrity.YES, ServerAuthentication.YES)
 * so that only a properly authenticated service will be used.
 */

import net.jini.constraint.*;
import net.jini.core.constraint.*;
import net.jini.jeri.ssl.SslEndpoint;
import net.jini.core.discovery.LookupLocator;
import net.jini.lookup.ServiceDiscoveryManager;

au.net.zeus.jgdms.hello.client {

    /*
     * -------------------------------------------------------------------------
     * Lookup groups to search (default: public multicast group).
     * -------------------------------------------------------------------------
     */
    lookupGroups = new String[]{ "" };

    /*
     * -------------------------------------------------------------------------
     * Unicast locators (optional).  Add jini://host[:port] entries to locate
     * specific lookup services without multicast.
     * -------------------------------------------------------------------------
     */
    lookupLocators = new LookupLocator[0];

    /*
     * -------------------------------------------------------------------------
     * How long (ms) to wait for a HelloService to appear.
     * -------------------------------------------------------------------------
     */
    lookupTimeoutMs = 15000L;

    /*
     * -------------------------------------------------------------------------
     * The name to pass to HelloService.sayHello().
     * -------------------------------------------------------------------------
     */
    greetingName = "World";
}

/*
 * ServiceDiscoveryManager configuration: require integrity and server
 * authentication on all interactions with lookup services discovered
 * via multicast.
 */
net.jini.lookup.ServiceDiscoveryManager {

    /*
     * Proxy preparer used to validate and constrain each service proxy
     * returned from a lookup service before handing it to the client.
     *
     * The preparer applies outbound method constraints so that:
     *   - Integrity.YES    : every call is integrity-protected by TLS
     *   - ServerAuthentication.YES : the server must present a valid cert
     */
    proxyPreparer =
        new BasicProxyPreparer(
            true,   /* verify */
            new BasicMethodConstraints(
                new InvocationConstraints(
                    new InvocationConstraint[]{
                        Integrity.YES,
                        ServerAuthentication.YES
                    },
                    null
                )
            ),
            null    /* no extra permissions required */
        );
}
