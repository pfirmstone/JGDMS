/*
 * Groovy configuration — Hello World Client
 *
 * This is the Groovy equivalent of hello-world-client.config.
 * Note how InvocationConstraints is constructed from a plain list
 * instead of a verbose array literal — no import mess needed.
 *
 * To use Groovy config, ensure the groovy-config module is on the
 * classpath (re-enable it in JGDMS/pom.xml) and pass this file to
 * ConfigurationProvider.getInstance(configArgs, classLoader).
 *
 * Component: au.net.zeus.jgdms.hello.client
 */
import net.jini.core.constraint.Integrity
import net.jini.core.constraint.ServerAuthentication
import net.jini.core.constraint.InvocationConstraints
import net.jini.constraint.BasicMethodConstraints
import net.jini.lookup.entry.BasicProxyPreparer

'au.net.zeus.jgdms.hello.client' {
    lookupGroups    = [''] as String[]
    lookupLocators  = [] as net.jini.core.discovery.LookupLocator[]
    lookupTimeoutMs = 15000L
    greetingName    = 'World'
}

/*
 * ServiceDiscoveryManager: require integrity + server authentication on every
 * proxy returned from a lookup service.
 */
'net.jini.lookup.ServiceDiscoveryManager' {
    proxyPreparer = new BasicProxyPreparer(
        true,
        new BasicMethodConstraints(
            new InvocationConstraints([Integrity.YES, ServerAuthentication.YES], null)
        ),
        null
    )
}
