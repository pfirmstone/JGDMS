<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus.jgdms</groupId>
        <artifactId>outrigger</artifactId>
        <version>4.0.0-SNAPSHOT</version>
    </parent>

    <groupId>au.net.zeus.jgdms.outrigger</groupId>
    <artifactId>outrigger-snaplogstore</artifactId>
    <packaging>jar</packaging>

    <name>Module :: Outrigger Snaplogstore</name>

    <dependencies>
        <dependency>
            <groupId>au.net.zeus.jgdms.outrigger</groupId>
            <artifactId>outrigger-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: PoisonSuperclassesRestartTest starts a real server, whose join manager
             loads the discovery format providers named in jgdms-resources. -->
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-discovery-providers</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
              <groupId>biz.aQute.bnd</groupId>
              <artifactId>bnd-maven-plugin</artifactId>
              <executions>
                    <execution>
                        <goals>
                            <goal>bnd-process</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Tests only: PoisonSuperclassesRestartTest compiles against jgdms-der
                         (release 25, uses java.lang.Record), as outrigger-service (release 21) does.
                         The main sources keep the parent's release. -->
                    <testRelease>21</testRelease>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- PoisonSuperclassesRestartTest builds real EntryReps, whose static init
                             pulls in the RMI codebase machinery. Use the default RMI class
                             provider so the test JVM needs no preferred-class-loader SPI on its
                             classpath (same setting as outrigger-service). -->
                        <java.rmi.server.RMIClassLoaderSpi>default</java.rmi.server.RMIClassLoaderSpi>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
