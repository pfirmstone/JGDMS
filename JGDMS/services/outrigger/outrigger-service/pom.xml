<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus.jgdms</groupId>
        <artifactId>outrigger</artifactId>
        <version>4.0.0-SNAPSHOT</version>
    </parent>

    <groupId>au.net.zeus.jgdms.outrigger</groupId>
    <artifactId>outrigger-service</artifactId>
    <packaging>jar</packaging>

    <name>Module :: Outrigger Service Implementation</name>

    <dependencies>
        <dependency>
            <groupId>au.net.zeus.jgdms.outrigger</groupId>
            <artifactId>outrigger-dl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-activation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-url-integrity</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-collections</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-all</artifactId>
            <version>1.7</version>
            <scope>test</scope>
        </dependency>
        <!--
          Test-only: provides the DER MarshalFactoryProvider (ServiceLoader
          discovered by net.jini.io.MarshalledInstance) so that tests can
          actually decode MarshallingFormat.ATOMIC_DER-tagged instances at
          test-runtime (JoinStateManagerDerFormatTest,
          StorableReferenceDerFormatTest, covering the outrigger write
          sites from the AtomicMarshalledInstance to DER migration, commit
          221fe251c). Originally added test-scope only (a runtime SPI
          provider, not referenced by any compiled symbol at the time).
          Bumped to compile scope: trunk's born-immutable configured-format
          entry marshalling (5899a7f9e) added a real main-source compile
          dependency on jgdms-der (OutriggerServerImpl's AtomicDerILFactory
          usage needs DerInputLimits), previously satisfied only by a
          deeper transitive path via jgdms-jeri. Declaring it here directly
          at test scope shadowed that transitive compile-scope resolution
          under Maven's nearest-declaration-wins mediation, breaking the
          main-source compile after this branch rebased on top of 5899a7f9e.
          A direct compile-scope declaration here is correct either way now.
        -->
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-der</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          CEL filter admission (SOW Part B, unit B1). outrigger-service is the
          server side: it decodes the opaque celWire carried in a FilterEnvelope
          (defined in outrigger-dl, no CEL dependency) and verifies it against
          the query template's own v2 schema chain before matching. jgdms-cel is
          release-25, as jgdms-der already is; this module targets release 21 and
          already depends on the release-25 jgdms-der artifact, so this follows
          the identical established precedent. The client-side CEL *authoring*
          path (CelTextParser/CelEncoder) is deliberately NOT here — it lives in
          the separate client module outrigger-cel-authoring.
        -->
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-cel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Test-only: build real CEL wire (CelTextParser/CelEncoder/
             CelRecordBuilder) to exercise the FilterAdmission verify-reject
             matrix. Not a main-source dependency (the server never authors). -->
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-cel-authoring</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
              <groupId>biz.aQute.bnd</groupId>
              <artifactId>bnd-maven-plugin</artifactId>
              <executions>
                    <execution>
                        <goals>
                            <goal>bnd-process</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin> 
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- EntryFieldIndexTest builds real EntryReps, whose static init
                             pulls in the RMI codebase machinery. Use the default RMI class
                             provider so the test JVM needs no preferred-class-loader SPI on
                             its classpath; the index logic under test is independent of the
                             class provider. -->
                        <java.rmi.server.RMIClassLoaderSpi>default</java.rmi.server.RMIClassLoaderSpi>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
