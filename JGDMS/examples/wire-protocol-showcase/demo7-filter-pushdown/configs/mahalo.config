/*
 * demo7 transient Mahalo (transaction manager) configuration.
 *
 * serverExporter uses PLAINTEXT TcpServerEndpoint (no TLS, no keystore) with
 * AtomicILFactory (JOSS is fine for Mahalo). No server constraints (first arg
 * null): plaintext TCP cannot satisfy Integrity.YES, so no integrity-only
 * constraint set here. loginContext = null: no JAAS login / Subject needed for
 * plaintext TCP. See outrigger.config for the tcp MarshallingFormat defer-fix
 * dependency.
 */

import net.jini.jeri.AtomicILFactory;
import net.jini.jeri.BasicJeriExporter;
import net.jini.jeri.tcp.TcpServerEndpoint;

org.apache.river.mahalo {

    loginContext = null;

    /* See outrigger.config: whitespace-only annotation -> empty codebase ->
     * proxy classes resolve from the local classpath, no codebase server. */
    Codebase_Annotation = " ";

    serverExporter = new BasicJeriExporter(
        TcpServerEndpoint.getInstance("127.0.0.1", 0),
        new AtomicILFactory(null, null,
            org.apache.river.mahalo.proxy.TxnManager.class, true),
        false,
        true);
}
