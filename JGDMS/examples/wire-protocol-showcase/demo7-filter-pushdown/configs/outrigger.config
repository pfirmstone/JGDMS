/*
 * demo7 transient Outrigger configuration.
 *
 * serverExporter uses PLAINTEXT TcpServerEndpoint (no TLS, no keystore) with the
 * born-DER AtomicDerILFactory. This is exactly the same shape as the transient
 * Outrigger's built-in default exporter -- the DER wire format the filter feature
 * is about, over plain TCP so this same-host, single-JVM demo needs no
 * transport-security setup.
 *
 * No server constraints (the first AtomicDerILFactory argument is null):
 * plaintext TCP cannot satisfy Integrity.YES (only a TLS transport can), so an
 * integrity-only constraint set -- as in the qa DER config, which runs over
 * SslServerEndpoint -- would fail to export here. The class-free DER filtering
 * this demo proves does not depend on transport integrity.
 *
 * NOTE (test-only dependency): a DER-only Outrigger proxy pins
 * MarshallingFormat.ATOMIC_DER as a wire-layer requirement, but the JERI
 * transports never learned to DEFER that invocation-layer constraint (an
 * incomplete JGDMS-STD-008 sec.18.3 rollout across all four transports:
 * tcp/http/uds/ssl). demo7 depends on a one-line tcp defer-fix in
 * net.jini.jeri.tcp.Constraints; see
 * docs/FINDING-JERI-MarshallingFormat-Plaintext-Transport-Gap.md.
 *
 * loginContext = null: no JAAS login / Subject needed for plaintext TCP.
 */

import net.jini.jeri.AtomicDerILFactory;
import net.jini.jeri.BasicJeriExporter;
import net.jini.jeri.tcp.TcpServerEndpoint;

org.apache.river.outrigger {

    loginContext = null;

    /*
     * Codebase annotation for the exported smart proxy. A whitespace-only value
     * is returned verbatim by getClassAnnotation() and tokenises to an EMPTY
     * codebase on the receiver, so proxy classes resolve from the local
     * classpath (an empty/default annotation resolves to null for an
     * app-classpath class and NPEs the receiver). No codebase server is needed.
     */
    Codebase_Annotation = " ";

    serverExporter = new BasicJeriExporter(
        TcpServerEndpoint.getInstance(0),
        new AtomicDerILFactory(null, null,
            org.apache.river.outrigger.proxy.OutriggerServer.class),
        false,
        true);
}
