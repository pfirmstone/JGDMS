<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus</groupId>
        <artifactId>jgdms</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>au.net.zeus.jgdms</groupId>
    <artifactId>jgdms-der</artifactId>
    <packaging>jar</packaging>

    <name>Module :: JGDMS DER Wire Format</name>
    <description>Language-neutral DER (X.690) wire-format codec for @AtomicSerial
        objects, per JGDMS-STD-006. Pure DER TLV primitives, schema digests,
        the GetArg complete-field-store decoder, and the MarshalledInstance
        container.</description>

    <properties>
        <jqwik.version>1.8.4</jqwik.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>au.net.zeus.jgdms</groupId>
            <artifactId>jgdms-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- jgdms-der uses java.lang.ScopedValue (the nested-carrier DoS depth guard in
                         DerMarshalInstanceInput), which is a PREVIEW API in JDK 21 through 24 and only
                         finalised in JDK 25 (JEP 506). Targeting release 25 lets it compile without the
                         enable-preview flag (which would pin der bytecode to a single JDK). Consequence:
                         jgdms-der requires a JDK 25+ runtime (DirtyChai) and will not run on Java 21. -->
                    <release>25</release>
                    <debug>true</debug>
                    <encoding>UTF-8</encoding>
                    <meminitial>128m</meminitial>
                    <maxmem>1024m</maxmem>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
