<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus.jgdms</groupId>
        <artifactId>tools</artifactId>
        <version>4.0.0-SNAPSHOT</version>
    </parent>

    <groupId>au.net.zeus.jgdms.tools</groupId>
    <artifactId>serial-schema-tracker</artifactId>

    <name>Module :: Serial Schema Tracker</name>
    <description>Build-time tracker for serialization schema evolution.
        Entry mode (GATE): for @SerialEntry classes, computes the registrar
        type hash via the runtime ClassMapper (bit-identical to the registrar),
        and fails on a hash change between releases (silent registrar-invisibility
        per JGDMS-STD-005 RULE-7). @AtomicSerial mode (INFORMATIVE): ASM-extracts
        serialForm()/entryForm() (name,type) schema and reports field-level drift.
        See docs/JGDMS-API-Compatibility-Accepted-Breaks.md.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>8</release>
                    <debug>true</debug>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Main-Class>org.apache.river.tool.serial.SerialSchemaTracker</Main-Class>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
