<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus.jgdms</groupId>
        <artifactId>tools</artifactId>
        <version>3.1.1-SNAPSHOT</version>
    </parent>

    <groupId>au.net.zeus.jgdms.tools</groupId>
    <artifactId>preferred-list-analyzer</artifactId>

    <name>Module :: Preferred-Class Analyzer</name>
    <description>Build-time ASM bytecode analyzer that classifies classes as
        Preferred: true (isolate) or false (share) for META-INF/PREFERRED.LIST,
        based on shared-static-state isolation hazards and cross-boundary type
        identity. See docs/SOW-PreferredList-Analyzer.md.
    </description>

    <properties>
        <!-- Compiled module the build-time linter analyses (relative to this module). -->
        <preferred.target.classes>${project.basedir}/../../jgdms-platform/target/classes</preferred.target.classes>
        <preferred.target.list>${project.basedir}/../../jgdms-platform/src/main/resources/META-INF/PREFERRED.LIST</preferred.target.list>
        <preferred.target.overrides>${project.basedir}/../../jgdms-platform/src/main/resources/META-INF/preferred-overrides.txt</preferred.target.overrides>
        <!-- Skip the build-time check (e.g. when building this module standalone). -->
        <preferred.check.skip>false</preferred.check.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>8</release>
                    <debug>true</debug>
                    <encoding>UTF-8</encoding>
                    <meminitial>128m</meminitial>
                    <maxmem>1024m</maxmem>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Main-Class>org.apache.river.tool.preferred.PreferredListTool</Main-Class>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Build-time integration: lint jgdms-platform's checked-in
              PREFERRED.LIST against a fresh analysis and FAIL the build on drift
              (the - -fail-on-drift arg below), so the derived list cannot silently
              rot. Writes the analysis report to target/preferred-list/.  This
              module builds after jgdms-platform in the reactor, so its
              target/classes exist; if they do not, the tool skips gracefully.
              To regenerate the live list after an intended change, run:
                generate ${preferred.target.classes} - -out ${preferred.target.list}
              Disable the gate with -Dpreferred.check.skip=true.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>preferred-list-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${preferred.check.skip}</skip>
                            <target>
                                <java classname="org.apache.river.tool.preferred.PreferredListTool"
                                      classpathref="maven.runtime.classpath"
                                      fork="true"
                                      failonerror="true">
                                    <arg value="check"/>
                                    <arg value="${preferred.target.classes}"/>
                                    <arg value="--list"/>
                                    <arg value="${preferred.target.list}"/>
                                    <arg value="--overrides"/>
                                    <arg value="${preferred.target.overrides}"/>
                                    <arg value="--report"/>
                                    <arg value="${project.build.directory}/preferred-list/jgdms-platform.report.txt"/>
                                    <arg value="--fail-on-drift"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
