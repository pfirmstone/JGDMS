<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>au.net.zeus</groupId>
        <artifactId>jgdms</artifactId>
        <version>3.1.1-SNAPSHOT</version>
    </parent>

    <groupId>au.net.zeus.jgdms.tools</groupId>
    <artifactId>service-proxy-processor</artifactId>

    <name>Tool :: @JiniService/@SmartProxy service-proxy annotation processor</name>
    <description>Annotation processor that generates the mechanical service-proxy
        boilerplate for @JiniService / @SmartProxy annotated interfaces: the
        server-side backend (internal wire) interface, the single constrainable
        proxy with a fail-closed create() factory, and optionally the service
        wrapper -- without modifying the annotated class.  Ships a validate-only
        mode that emits warnings for constrainability / contract violations.
        Depends only on the JDK (java.compiler); it references the JGDMS API and
        the service-proxy annotations by name.
    </description>

    <dependencies>
        <!-- Test-only: the JUnit runner and the JDK compiler API drive the
             processor over in-memory sources; no compile dependency is needed
             because the processor references every JGDMS/annotation type by
             name (source-retained annotations, javax.lang.model). -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <!-- this module IS an annotation processor; do not run processors on it -->
                    <proc>none</proc>
                    <!-- do not inherit the parent's processor path: it points back at this module -->
                    <annotationProcessorPaths combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
