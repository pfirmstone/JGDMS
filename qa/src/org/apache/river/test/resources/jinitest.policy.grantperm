//

// proxy codebase: http://*/jsk-dl.jar
// proxy-shape permissions present: false
grant codebase "http://*/jsk-dl.jar" {
    permission net.jini.security.GrantPermission "org.apache.river.api.io.DeSerializationPermission \"ATOMIC\";";
};

// proxy codebase: http://*/phoenix-dl.jar
