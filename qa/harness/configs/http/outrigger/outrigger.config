import net.jini.discovery.ConstrainableLookupLocator;
import net.jini.core.discovery.LookupLocator;
import net.jini.security.BasicProxyPreparer;
import net.jini.jeri.BasicJeriExporter;
import net.jini.jeri.AtomicDerILFactory;
import net.jini.jeri.http.HttpServerEndpoint;
import net.jini.activation.arg.ActivationID;
import net.jini.activation.ActivationExporter;
import net.jini.constraint.BasicMethodConstraints;
import net.jini.constraint.BasicMethodConstraints.MethodDesc;
import net.jini.core.constraint.InvocationConstraint;
import net.jini.core.constraint.InvocationConstraints;
import org.apache.river.discovery.MulticastTimeToLive;

multicast {
    private ttl = 1;
}

org.apache.river.outrigger {
    locatorConstraints = net.jini.discovery.LookupDiscovery.discoveryConstraints;
}

net.jini.lookup.JoinManager {
    registrarPreparer = new BasicProxyPreparer();
    registrationPreparer = new BasicProxyPreparer();
    serviceLeasePreparer = new BasicProxyPreparer();
}

net.jini.discovery.LookupDiscovery {
    registrarPreparer = new BasicProxyPreparer();
    discoveryConstraints = new BasicMethodConstraints(
        new MethodDesc[] {
            new MethodDesc(new InvocationConstraints(
                new InvocationConstraint[] {
                    new MulticastTimeToLive(multicast.ttl)
                },
                null
            ))
        }
    );
}

net.jini.discovery.LookupLocatorDiscovery {
    registrarPreparer = new BasicProxyPreparer();
}

/* Outrigger is ATOMIC_DER-only in JGDMS 4.0.0: AtomicDerILFactory is the
 * exporter invocation layer unconditionally -- in the service default and
 * in every QA transport config (SOW-Outrigger-DER-Only-JOSS-Rejection.md,
 * ratified decision 2; this config's sweep is sec.3 item 8 / U1c).
 *
 * NOT FOR DEPLOYMENT (sec.9.2 ruling): the http transport is plaintext
 * and non-secure; this harness config is retained for testing prior to
 * deployment only.
 */
exporter {
    name = "org.apache.river.outrigger.serverExporter";
    activatableExporter = new ActivationExporter(
                        (ActivationID) $data,
                        new BasicJeriExporter(HttpServerEndpoint.getInstance(0),
				    	      new AtomicDerILFactory(null,
				    	          org.apache.river.outrigger.proxy.OutriggerServer.class)));

    persistentExporter = new BasicJeriExporter(HttpServerEndpoint.getInstance(0),
				    new AtomicDerILFactory(null,
				        org.apache.river.outrigger.proxy.OutriggerServer.class));
    transientExporter = new BasicJeriExporter(HttpServerEndpoint.getInstance(0),
				    new AtomicDerILFactory(null,
				        org.apache.river.outrigger.proxy.OutriggerServer.class));
}


