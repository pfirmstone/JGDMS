/* JAAS login configurations for SPIFFE SVID-based authentication.
 *
 * Each login context maps to SpiffeLoginModule, which reads SVID credentials
 * from PEM files located under:
 *
 *   ${net.jini.jeri.ssl.spiffe.dir}/<serviceRole>/svid.pem
 *   ${net.jini.jeri.ssl.spiffe.dir}/<serviceRole>/svid_key.pem
 *
 * Set the system property net.jini.jeri.ssl.spiffe.dir to the directory
 * produced by qa/harness/trust/gen-spiffe-svids.sh before starting any JVM
 * using this login configuration.
 */

org.apache.river.Reggie {
    au.net.zeus.jgdms.spiffe.SpiffeLoginModule required
        serviceRole="reggie";
};

org.apache.river.Mahalo {
    au.net.zeus.jgdms.spiffe.SpiffeLoginModule required
        serviceRole="mahalo";
};

org.apache.river.Outrigger {
    au.net.zeus.jgdms.spiffe.SpiffeLoginModule required
        serviceRole="outrigger";
};

org.apache.river.Mercury {
    au.net.zeus.jgdms.spiffe.SpiffeLoginModule required
        serviceRole="mercury";
};

org.apache.river.Norm {
    au.net.zeus.jgdms.spiffe.SpiffeLoginModule required
        serviceRole="norm";
};

org.apache.river.Fiddler {
    au.net.zeus.jgdms.spiffe.SpiffeLoginModule required
        serviceRole="fiddler";
};

org.apache.river.Phoenix {
    au.net.zeus.jgdms.spiffe.SpiffeLoginModule required
        serviceRole="phoenix";
};

org.apache.river.Test {
    au.net.zeus.jgdms.spiffe.SpiffeLoginModule required
        serviceRole="tester";
};

org.apache.river.Group {
    au.net.zeus.jgdms.spiffe.SpiffeLoginModule required
        serviceRole="group";
};
