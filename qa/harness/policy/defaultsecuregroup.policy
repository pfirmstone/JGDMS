grant principal org.apache.river.api.security.UnresolvedPrincipal "${fiddler}",
{
    permission net.jini.security.AccessPermission "*";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "${mahalo}",
{
    permission net.jini.security.AccessPermission "*";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "${mercury}",
{
    permission net.jini.security.AccessPermission "*";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "${norm}",
{
    permission net.jini.security.AccessPermission "*";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "${outrigger}",
{
    permission net.jini.security.AccessPermission "*";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "${reggie}",
{
    permission net.jini.security.AccessPermission "*";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "${test}",
{
    permission net.jini.security.AccessPermission "*";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Fiddler",
{
    permission net.jini.security.AccessPermission "*";
    permission java.lang.RuntimePermission "accessClassInPackage.com.sun.proxy";
    permission java.net.SocketPermission "[0:0:0:0:0:0:0:1]:1098", "connect,resolve";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Mahalo",
{
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Mahalo\" peer javax.security.auth.x500.X500Principal \"CN=Phoenix\"", "connect";
    permission net.jini.security.AccessPermission "*";
    permission java.lang.RuntimePermission "createPlatformThread";
    permission java.lang.RuntimePermission "createVirtualThread";
    permission java.net.SocketPermission "[0:0:0:0:0:0:0:1]:1098", "connect,resolve";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Mercury",
{
    permission java.util.PropertyPermission "org.apache.river.reggie.enableImplToStubReplacement", "read";
    permission net.jini.security.AccessPermission "*";
    permission java.lang.RuntimePermission "createPlatformThread";
    permission java.lang.RuntimePermission "createVirtualThread";
    permission java.net.SocketPermission "[0:0:0:0:0:0:0:1]:1098", "connect,resolve";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Norm",
{
    permission net.jini.security.AccessPermission "*";
    permission java.net.SocketPermission "[0:0:0:0:0:0:0:1]:1098", "connect,resolve";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Outrigger",
{
    permission net.jini.security.AccessPermission "*";
    permission java.net.SocketPermission "[0:0:0:0:0:0:0:1]:1098", "connect,resolve";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Phoenix",
{
    permission net.jini.loader.pref.BootstrapPermission "loadCodebase";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Reggie",
{
    permission net.jini.security.AccessPermission "*";
    permission java.net.SocketPermission "[0:0:0:0:0:0:0:1]:1098", "connect,resolve";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Tester",
{
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Tester\" peer javax.security.auth.x500.X500Principal \"CN=Outrigger\"", "connect";
    permission net.jini.security.AccessPermission "*";
    permission java.net.SocketPermission "[0:0:0:0:0:0:0:1]:1098", "connect,resolve";
};

grant {
    permission org.apache.river.api.io.DeSerializationPermission "ATOMIC";
    permission org.apache.river.api.io.DeSerializationPermission "ENTRY";
    permission org.apache.river.api.io.DeSerializationPermission "MARSHALL";
    permission java.lang.RuntimePermission "accessClassInPackage.com.sun.proxy";
    permission java.security.AllPermission "<all permissions>", "<all actions>";
};

