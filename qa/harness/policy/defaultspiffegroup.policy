};

// --- baseline for ALL protection domains, including hosted/business-side code ---
// AllPermission removed 2026-07-20 (was granted here unqualified, handing
// AuthPermission("callAs"/"doAs") and RuntimePermission("setSecurityManager")
// to every domain in the JVM -- undermining the fail-closed precondition that
// AdminPrincipalAuthenticator relies on: see jgdms-pref-class-loader/.../
// loader/isolation/AdminPrincipalAuthenticator.java. Java policy is
// default-deny, so removing this unqualified grant is what makes it denied;
// no explicit deny rule needed. Only the narrow, least-privilege perms below
// are granted to every domain. Trusted service jars/threads get anything
// further via the jrt:/principal-scoped grants above; hosted/business-side
// code gets nothing beyond this.
grant {
    permission org.apache.river.api.io.DeSerializationPermission "ATOMIC";
    permission org.apache.river.api.io.DeSerializationPermission "ENTRY";
    permission org.apache.river.api.io.DeSerializationPermission "MARSHALL";
    permission java.lang.RuntimePermission "createVirtualThread";
    permission java.lang.RuntimePermission "createPlatformThread";
};

