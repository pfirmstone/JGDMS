grant principal org.apache.river.api.security.UnresolvedPrincipal "spiffe://test.jgdms.local/svc/fiddler",
{
    permission java.net.SocketPermission "[0:0:0:0:0:0:0:1]:1098", "connect,resolve";
    permission java.lang.RuntimePermission "accessClassInPackage.com.sun.proxy";
    permission java.lang.RuntimePermission "modifyThread";
    permission net.jini.security.AccessPermission "*";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "spiffe://test.jgdms.local/svc/mahalo",
{
    permission java.net.SocketPermission "[0:0:0:0:0:0:0:1]:1098", "connect,resolve";
    permission java.lang.RuntimePermission "createPlatformThread";
    permission java.lang.RuntimePermission "createVirtualThread";
    permission java.lang.RuntimePermission "modifyThread";
    permission net.jini.security.AccessPermission "*";
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Mahalo\" peer javax.security.auth.x500.X500Principal \"CN=Phoenix\"", "connect";
};

grant principal org.apache.river.api.security.UnresolvedPrincipal "spiffe://test.jgdms.local/svc/mercury",
{
    permission java.net.SocketPermission "[0:0:0:0:0:0:0:1]:1098", "connect,resolve";
    permission java.lang.RuntimePermission "createPlatformThread";
