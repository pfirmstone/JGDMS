grant {
    permission java.security.AllPermission "<all permissions>", "<all actions>";
};


// WIDENING-DRIVE (throwaway, reset after green)
grant {
    permission java.io.FilePermission "/tmp/-", "read,write,delete";
    permission java.net.SocketPermission "localhost:1024-65535", "connect,listen,accept,resolve";
    permission java.net.SocketPermission "ArkPC-28365281:1024-65535", "connect,listen,accept,resolve";
    permission java.net.SocketPermission "[::1]:1024-65535", "connect,listen,accept,resolve";
    permission java.net.SocketPermission "127.0.0.1:1024-65535", "connect,listen,accept,resolve";
};

// WIDENING-DRIVE-2 (throwaway: AccessPermission for bootstrap-proxy + service methods)
grant {
    permission net.jini.security.AccessPermission "*";
};

// WIDENING-DRIVE-3 (throwaway: qualified CodebaseAccessor bootstrap methods)
grant {
    permission net.jini.security.AccessPermission "net.jini.export.CodebaseAccessor.*";
};

