grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Tester"
{
    // A grant to a Principal applies to ANY thread running with that principal,
    // regardless of codebase/signer/digest.  The bootstrap codebase provider and
    // the grant facility (net.jini.security.Security.grant) both run on the
    // authenticated CN=Tester thread when a proxy codebase is prepared, so this one
    // grant covers every frame in the GrantPermission check -- authorizing CN=Tester
    // to issue the dynamic DownloadPermission + URLPermission codebase grants.
    permission net.jini.security.GrantPermission "delim=| net.jini.loader.DownloadPermission; java.net.URLPermission |http://*:*/-|, |*:*|; java.net.URLPermission |httpmd://*:*/-|, |*:*|";
};

