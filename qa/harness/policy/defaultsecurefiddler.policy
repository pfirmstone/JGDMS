grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Fiddler",
{
    permission javax.security.auth.AuthPermission "getSubject";
    permission java.lang.RuntimePermission "accessClassInPackage.com.sun.proxy";
    permission java.lang.RuntimePermission "modifyThread";
    permission net.jini.security.AccessPermission "*";
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Fiddler\" peer javax.security.auth.x500.X500Principal \"CN=Phoenix\"", "connect";
    permission java.util.PropertyPermission "org.apache.river.reggie.enableImplToStubReplacement", "read";
};

