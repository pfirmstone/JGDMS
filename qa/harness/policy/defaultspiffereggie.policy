// --- baseline for ALL protection domains, including hosted/business-side code ---
// AllPermission removed 2026-07-20 (was granted here unqualified, handing
// AuthPermission("callAs"/"doAs") and RuntimePermission("setSecurityManager")
// to every domain in the JVM -- undermining the fail-closed precondition that
// AdminPrincipalAuthenticator relies on: see jgdms-pref-class-loader/.../
// loader/isolation/AdminPrincipalAuthenticator.java. The former "spiffe Linux
// bring-up scaffold" blocks (unqualified RuntimePermission "*" and explicit
// AuthPermission "*") are removed for the same reason -- RuntimePermission "*"
// implies setSecurityManager. Java policy is default-deny, so removing these
// unqualified grants is what makes them denied; no explicit deny rule needed.
// Only the narrow, least-privilege perms below are granted to every domain.
// The removed scaffold also granted SecurityPermission/NetPermission/
// ReflectPermission/SocketPermission wildcards and DirtyChai's native/
// class-loading guards -- no narrow replacement for those has been derived
// yet. If enabling a live SecurityManager for this config surfaces an
// AccessControlException for one of those, use polpAudit to derive the
// real, narrowly-scoped grant for the specific trusted codebase that needs
// it -- do not restore the wildcard. Mirrors the convention already used in
// defaultsecuremahalo.policy ("Emptied for clean cross-platform polpAudit
// regeneration").
// Trusted service jars/threads get anything further via the jrt:/principal
// -scoped grants above; hosted/business-side code gets nothing beyond this.
grant {
    permission java.io.FilePermission "<<ALL FILES>>", "read";
    permission org.apache.river.api.io.DeSerializationPermission "ATOMIC";
    permission org.apache.river.api.io.DeSerializationPermission "ENTRY";
    permission org.apache.river.api.io.DeSerializationPermission "MARSHALL";
    permission java.lang.RuntimePermission "createVirtualThread";
    permission java.lang.RuntimePermission "createPlatformThread";
};
