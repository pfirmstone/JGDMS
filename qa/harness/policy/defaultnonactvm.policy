grant codebase "file:${jsk.home}/lib/jgdms-collections-3.1.1-SNAPSHOT.jar",
principal org.apache.river.api.security.UnresolvedPrincipal "CN=Tester",
{
    permission javax.security.auth.AuthPermission "callAs";
};

// §7.3 two-gate: grant the matching-test client (tester) AccessPermission for
// remote method invocation.  reggie's NonActivatableGroup VM evaluates Gate-1
// against this policy (its java.security.policy), so the grant must live here, not
// in the per-service policy file.  Real principal classes (not UnresolvedPrincipal
// used as the class) so the grant resolves; the SpiffePrincipal class name is held
// as a string by the policy parser, so this remains portable to non-DirtyChai
// config sets (there it simply never matches).
grant principal javax.security.auth.x500.X500Principal "CN=Tester",
      principal au.zeus.jdk.authorization.spire.SpiffePrincipal "spiffe://test.jgdms.local/svc/tester"
{
    permission net.jini.security.AccessPermission "*";
};

