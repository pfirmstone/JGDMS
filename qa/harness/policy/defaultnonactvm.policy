    permission net.jini.security.AccessPermission "net.jini.export.CodebaseAccessor.getClassAnnotation";
    permission net.jini.security.AccessPermission "net.jini.export.CodebaseAccessor.getEncodedCerts";
    permission net.jini.security.AccessPermission "net.jini.export.CodebaseAccessor.getBootstrapProxy";
    permission net.jini.security.AccessPermission "net.jini.export.CodebaseAccessor.getClassLoader";
};
grant principal org.apache.river.api.security.UnresolvedPrincipal "CN=Group",
{
    permission net.jini.security.AccessPermission "net.jini.export.CodebaseAccessor.getClassAnnotation";
    permission net.jini.security.AccessPermission "net.jini.export.CodebaseAccessor.getEncodedCerts";
    permission net.jini.security.AccessPermission "net.jini.export.CodebaseAccessor.getBootstrapProxy";
    permission net.jini.security.AccessPermission "net.jini.export.CodebaseAccessor.getClassLoader";
};
// --- spiffe bring-up scaffold for group/non-activatable VMs (THROWAWAY; audit-scope later) ---
// Group VMs host services under SM; same boring-perms as the spiffe service policies.
// SPIFFE auth (AuthenticationPermission), AccessPermission, GrantPermission, BootstrapPermission
// are deliberately NOT here -> stay enforced.
grant {
    permission java.io.FilePermission "<<ALL FILES>>", "read,write,delete,execute";
    permission au.zeus.jdk.authorization.guards.LoadClassPermission "ALLOW";
    permission au.zeus.jdk.authorization.guards.DefineClassPermission "ALLOW";
    permission au.zeus.jdk.authorization.guards.SerialObjectPermission "*";
    permission au.zeus.jdk.authorization.guards.NativeInvocationPermission "*";
    permission au.zeus.jdk.authorization.guards.NativeMemoryPermission "*";
    permission java.security.SecurityPermission "*";
    permission java.lang.RuntimePermission "*";
    permission java.lang.reflect.ReflectPermission "*";
    permission java.net.NetPermission "*";
    permission java.net.SocketPermission "*", "connect,accept,listen,resolve";
    permission java.net.URLPermission "jrt:/-", "GET:";
    permission java.io.SerializablePermission "*";
    permission java.util.PropertyPermission "*", "read,write";
    permission java.util.logging.LoggingPermission "control";
    permission net.jini.io.context.ContextPermission "*";
    permission org.apache.river.api.io.DeSerializationPermission "*";
    permission javax.security.auth.AuthPermission "*";
    permission org.apache.river.thread.ThreadPoolPermission "*";
    permission net.jini.discovery.DiscoveryPermission "*";
};

// FIX-CANDIDATE (spiffe AuthenticationPermission for service codebase self-download): this is the
// NonActivatableGroup VM policy (java.security.policy of the GroupImpl that creates each service).
// Its many polpAudit-captured AuthenticationPermission grants miss the "CN=X peer CN=X"
// self-connection a service uses to download its OWN codebase during creation.  No "peer" clause
// => connect to / accept from any peer.  Blanket for the bring-up; tighten once green.
grant {
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Reggie\"" "connect,accept";
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Outrigger\"" "connect,accept";
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Mahalo\"" "connect,accept";
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Norm\"" "connect,accept";
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Fiddler\"" "connect,accept";
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Mercury\"" "connect,accept";
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Tester\"" "connect,accept";
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Phoenix\"" "connect,accept";
    permission net.jini.security.AuthenticationPermission "javax.security.auth.x500.X500Principal \"CN=Group\"" "connect,accept";
};

// =====================================================================================
// Codebase-download bring-up (group / non-activatable VMs).  Same three-layer chain as
// the test VM (see defaultspiffetest.policy): boot-window BootstrapPermission, the dynamic
// per-URL DownloadPermission+URLPermission grant (GrantPermission-gated), and the granted
// perms at fetch time.  The jgdms-pref-class-loader GrantPermission is already granted above
// (its codebase block); the boot-window BootstrapPermission for the remote codebases and the
// jgdms-platform GrantPermission (the second granting frame under doPrivileged) are added here.
// =====================================================================================

// Boot-window: trust the remote proxy codebases to be bootstrap-loaded, by CONTENT DIGEST.
// checkBootstrapPermissionByDigest checks BootstrapPermission against a DigestCodeSource (SHA-256
// of the downloaded JAR); a DigestGrant matches by content hash.  A "grant codebase \"httpmd://...\""
// cannot be used: httpmd URLs need a ;<alg>=<digest> to construct as a URL, and DirtyChai's parser
// validates codebases via RFC 3986 URL construction (HC-7) -> a wildcard httpmd codebase never loads.
// CAVEAT (bring-up): SHA-256 pins the current dl-jar bytes; regenerate via `sha256sum <dl-jar>` after
// any rebuild of the service dl jars.
grant digest "SHA-256:c0add336da0f2372a04677a995a6d2fb555b1630d84a23faf8bcb4693aa51d41" {   // reggie-dl
    permission net.jini.loader.pref.BootstrapPermission "loadCodebase";
};
grant digest "SHA-256:cddebf4d65970f444217d2ac3c853d96eb88c7155d6d4506922d198582d81c35" {   // jgdms-lib-dl
    permission net.jini.loader.pref.BootstrapPermission "loadCodebase";
};
grant digest "SHA-256:97f2b2d133f7af082c547f9a77e77528f503c3a0267196988a6cb7fd0e9bf543" {   // outrigger-dl
    permission net.jini.loader.pref.BootstrapPermission "loadCodebase";
};
grant digest "SHA-256:c9cf08b997ed31cb0e6681892321da80575c0410c830ca01d738709665141712" {   // qa1-outrigger-dl
    permission net.jini.loader.pref.BootstrapPermission "loadCodebase";
};
grant digest "SHA-256:4d250cafe0099cede3050114a1f4b3abb7f7e73bd3303180ac125f4c322d63e6" {   // qa1-share-dl
    permission net.jini.loader.pref.BootstrapPermission "loadCodebase";
};

// The second granting frame (Security.grant lives in jgdms-platform) needs GrantPermission too;
// under doPrivileged BOTH the provider (pref-class-loader, granted above) and platform are checked.
grant codebase "file:${jsk.home}/lib/jgdms-platform-3.1.1-SNAPSHOT.jar" {
    permission net.jini.security.GrantPermission "delim=| net.jini.loader.DownloadPermission; java.net.URLPermission |http://*:*/-|, |*:*|; java.net.URLPermission |httpmd://*:*/-|, |*:*|";
};

// FIX-CANDIDATE (spiffe per-method AccessPermission for the service VMs): services run under
// defaultnonactvm.policy (the spiffe configSet does not override the nonact-group VM policy), so
// the authenticated CLIENT principal seen by BasicInvocationDispatcher.checkClientPermission is a
// net.jini.jeri.ssl.SpiffePrincipal "spiffe://.../<role>" -- for which this policy had NO
// AccessPermission grants (only the X500 "CN=<role>" form, which the SVID does not present here).
// Grant AccessPermission to the spiffe service+client principals so server-side method access
// control passes.  Blanket "*" for bring-up; tighten to per-method (polpAudit) once green.
grant principal org.apache.river.api.security.UnresolvedPrincipal "spiffe://test.jgdms.local/svc/tester" {
    permission net.jini.security.AccessPermission "*";
};
grant principal org.apache.river.api.security.UnresolvedPrincipal "spiffe://test.jgdms.local/svc/reggie" {
    permission net.jini.security.AccessPermission "*";
};
grant principal org.apache.river.api.security.UnresolvedPrincipal "spiffe://test.jgdms.local/svc/outrigger" {
    permission net.jini.security.AccessPermission "*";
};
grant principal org.apache.river.api.security.UnresolvedPrincipal "spiffe://test.jgdms.local/svc/mahalo" {
    permission net.jini.security.AccessPermission "*";
};
grant principal org.apache.river.api.security.UnresolvedPrincipal "spiffe://test.jgdms.local/svc/norm" {
    permission net.jini.security.AccessPermission "*";
};
grant principal org.apache.river.api.security.UnresolvedPrincipal "spiffe://test.jgdms.local/svc/fiddler" {
    permission net.jini.security.AccessPermission "*";
};
grant principal org.apache.river.api.security.UnresolvedPrincipal "spiffe://test.jgdms.local/svc/mercury" {
    permission net.jini.security.AccessPermission "*";
};
