grant codebase "file:${jsk.home}/lib/jgdms-pref-class-loader-3.1.1-SNAPSHOT.jar",
{
    permission au.zeus.jdk.authorization.guards.LoadClassPermission "ALLOW";
    permission au.zeus.jdk.authorization.guards.DefineClassPermission "ALLOW";
    // PreferredProxyCodebaseProvider issues the dynamic codebase-download grant
    // (DownloadPermission + URLPermission) after it has authenticated the server
    // and verified the codebase; authorize it to grant those for http/httpmd.
    permission net.jini.security.GrantPermission "delim=| net.jini.loader.DownloadPermission; java.net.URLPermission |http://*:*/-|, |*:*|; java.net.URLPermission |httpmd://*:*/-|, |*:*|";
};

