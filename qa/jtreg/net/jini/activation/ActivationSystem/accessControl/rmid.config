import org.apache.river.phoenix.*;
import org.apache.river.phoenix.dl.*;
import org.apache.river.phoenix.group.*;
import javax.security.auth.login.LoginContext;
import net.jini.constraint.*;
import net.jini.constraint.BasicMethodConstraints.MethodDesc;
import net.jini.core.constraint.*;
import net.jini.jeri.*;
import net.jini.jeri.ssl.SslServerEndpoint;
import net.jini.security.*;
import au.net.zeus.rmi.tls.TlsRMIServerSocketFactory;
import au.net.zeus.rmi.tls.TlsRMIClientSocketFactory;

org.apache.river.phoenix {

    // The old "registryExporter = new RegistrySunExporter();" entry was
    // dead/vestigial: Activation.java never reads a "registryExporter"
    // config entry (it builds the java.rmi.registry.Registry directly via
    // LocateRegistry.createRegistry(port, registryRmiClientSocketFactory,
    // registryRmiServerSocketFactory), which -- unset here -- silently
    // defaulted to the plain (non-TLS) RMISocketFactory). That left the
    // Registry unsecured, while net.jini.activation.ActivationGroup.
    // getSystem() (the client-side lookup helper used by AccessControl)
    // unconditionally connects via TlsRMIClientSocketFactory, so the
    // client's TLS ClientHello hit a plain socket and the server aborted
    // the connection ("SSLHandshakeException: Remote host terminated the
    // handshake"). Fix: actually secure the Registry with the TLS
    // factory pair, matching the working reference config
    // qa/harness/configs/{jsse,der,spiffe}/phoenix/phoenix.config.
    registryRmiServerSocketFactory = new TlsRMIServerSocketFactory();
    registryRmiClientSocketFactory = new TlsRMIClientSocketFactory();

    private sep = SslServerEndpoint.getInstance(0);

    private clientAuth =
	new InvocationConstraints(ClientAuthentication.YES, null);

    private ssConstraints = new BasicMethodConstraints(new MethodDesc[]{
			new MethodDesc(clientAuth)});

    // permClass and policy were both null here, meaning
    // SystemDispatcher.invoke() never ran DefaultGroupPolicy.checkGroup
    // (registerGroup/setActivationGroupDesc content checks) AND, more
    // importantly, no per-method SystemPermission check ever happened at
    // all for *any* ActivationSystem method (unlike activatorExporter/
    // monitorExporter/instantiatorExporter below, which do wire their
    // permission classes) -- so every client could call every method,
    // defeating the entire point of this test. Wire both, matching the
    // pattern the other three exporters already use.
    systemExporter =
	new BasicJeriExporter(sep,
			      new SystemAccessAtomicILFactory(
							ssConstraints,
							SystemPermission.class,
							new DefaultGroupPolicy(),
							SystemAccessExporter.class));

    monitorExporter =
	new BasicJeriExporter(sep,
			      new AtomicILFactory(
				  new BasicMethodConstraints(clientAuth),
				  MonitorPermission.class,
				  SystemAccessExporter.class));

    activatorExporter =
	new BasicJeriExporter(sep,
			      new AtomicILFactory(
				  ssConstraints,
				  ActivatorPermission.class,
				  SystemAccessExporter.class));

    instantiatorExporter =
	new BasicJeriExporter(sep,
			      new AtomicILFactory(
				  new BasicMethodConstraints(clientAuth),
				  InstantiatorPermission.class,
				  org.apache.river.phoenix.group.ActivationGroupImpl.class));

    persistenceDirectory = "log";

    loginContext = new LoginContext("server");

    groupOptions = new String[]{
	"-Djsk.home=${jsk.home}",
	"-Dtest.src=${test.src}",
	"-Dtest.classes=${test.classes}",
	"-Djava.protocol.handler.pkgs=net.jini.url"
    };

}
