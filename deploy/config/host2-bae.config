/*
 * Host 2 — Bytecode Analysis Engine (BAE) startup configuration
 *
 * Stateless service; no log directory required.  Each replica registers
 * its own proxy stub in the Jini Lookup Service on Host 1, identified by
 * its individual SPIFFE ID (spiffe://<trust-domain>/host/bae/engine-N).
 *
 * Required environment variables:
 *   JGDMS_VERSION          — Maven artifact version
 *   JGDMS_SERVICE_HOST     — advertised pod IP (injected by Kubernetes)
 *   JGDMS_JERI_PORT        — JERI listen port (default 1098)
 *   JGDMS_LOOKUP_URL       — unicast lookup URL, e.g. jini://lookup.jgdms.svc.cluster.local:4160
 *   JGDMS_ENGINE_ID        — unique ID for this engine instance (e.g. engine-1)
 *   ENGINE_SIGNING_KEY     — path to PEM private key for signing JarAnalysisReports
 *   ENGINE_SIGNING_CERT    — path to PEM certificate matching the signing key
 *   TRUST_DOMAIN           — SPIFFE trust domain
 *   SPIRE_DIR              — SPIRE PEM directory (default /run/spire)
 */

import net.jini.core.discovery.LookupLocator;
import net.jini.jeri.BasicILFactory;
import net.jini.jeri.BasicJeriExporter;
import net.jini.jeri.ssl.SslServerEndpoint;
import net.jini.security.BasicProxyPreparer;

org.apache.river.start {

    serviceDescriptors = new org.apache.river.start.NonActivatableServiceDescriptor[] {
        new org.apache.river.start.NonActivatableServiceDescriptor(
            /* No public codebase HTTP server on BAE — only inbound JERI */
            "httpmd://" + System.getenv().getOrDefault("JGDMS_CODEBASE_HOST",
                System.getenv().getOrDefault("JGDMS_SERVICE_HOST", "localhost"))
            + ":" + System.getenv().getOrDefault("JGDMS_CODEBASE_PORT", "9080")
            + "/bytecode-analysis-engine-dl-"
            + System.getenv().getOrDefault("JGDMS_VERSION", "3.1.1-SNAPSHOT") + ".jar",

            "/opt/jgdms/policy/host2-bae.policy",

            "/opt/jgdms/lib/bytecode-analysis-engine-service-"
            + System.getenv().getOrDefault("JGDMS_VERSION","3.1.1-SNAPSHOT") + ".jar"
            + java.io.File.pathSeparator + "/opt/jgdms/lib/*",

            "au.net.zeus.jgdms.bae.BytecodeAnalysisEngineImpl",

            new String[]{ "/opt/jgdms/config/host2-bae.config" },

            null
        )
    };
}

au.net.zeus.jgdms.bae {

    serverEndpoint = SslServerEndpoint.getInstance(
        System.getenv().getOrDefault("JGDMS_SERVICE_HOST", "0.0.0.0"),
        Integer.parseInt(System.getenv().getOrDefault("JGDMS_JERI_PORT", "1098"))
    );

    exporter = new BasicJeriExporter(serverEndpoint, new BasicILFactory(), false, true);

    /* Lookup locators: register with Host 1 */
    initialLookupLocators = new LookupLocator[]{
        new LookupLocator(System.getenv().getOrDefault(
            "JGDMS_LOOKUP_URL", "jini://lookup.jgdms.svc.cluster.local:4160"))
    };

    initialLookupGroups = new String[0];

    /* Engine signing key material (mounted from Kubernetes Secret) */
    engineSigningKeyPath  = System.getenv().getOrDefault(
        "ENGINE_SIGNING_KEY",  "/opt/jgdms/keys/engine-signing-key.pem");
    engineSigningCertPath = System.getenv().getOrDefault(
        "ENGINE_SIGNING_CERT", "/opt/jgdms/keys/engine-signing-cert.pem");

    /* Unique engine identifier for BAE pool differentiation */
    engineId = System.getenv().getOrDefault("JGDMS_ENGINE_ID", "engine-1");

    lookupPreparer  = new BasicProxyPreparer();
    locatorPreparer = new BasicProxyPreparer();
}

net.jini.jeri.ssl {
    spireDir = System.getenv().getOrDefault("SPIRE_DIR", "/run/spire");
}
