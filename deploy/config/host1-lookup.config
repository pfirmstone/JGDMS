/*
 * Host 1 — Jini Lookup Service (Reggie) startup configuration
 *
 * Used by org.apache.river.start.ServiceStarter with
 * NonActivatableServiceDescriptor.  All values may be overridden by
 * system properties so that Kubernetes ConfigMaps and Secrets can inject
 * site-specific settings without rebuilding the image.
 *
 * Required system properties (supplied via Kubernetes env → ConfigMap):
 *   JGDMS_VERSION          — Maven artifact version, e.g. 3.1.1-SNAPSHOT
 *   JGDMS_LOOKUP_HOST      — advertised hostname/IP for JERI endpoint
 *   JGDMS_LOOKUP_PORT      — JERI listen port (default 4160)
 *   JGDMS_CODEBASE_HOST    — HTTP codebase server hostname
 *   JGDMS_CODEBASE_PORT    — HTTP codebase server port (default 9080)
 *   JGDMS_LOG_DIR          — persistent log directory (default /opt/jgdms/log)
 *   TRUST_DOMAIN           — SPIFFE trust domain
 *   SPIRE_DIR              — directory containing SPIRE PEM files (default /run/spire)
 */

import net.jini.core.discovery.LookupLocator;
import net.jini.jeri.BasicILFactory;
import net.jini.jeri.BasicJeriExporter;
import net.jini.jeri.ssl.SslServerEndpoint;
import net.jini.security.BasicProxyPreparer;

org.apache.river.start {

    /*
     * NonActivatableServiceDescriptor for Reggie.
     *
     * ServiceStarter passes the descriptors array to each descriptor's
     * create(Configuration) method in turn.
     */
    serviceDescriptors = new org.apache.river.start.NonActivatableServiceDescriptor[] {
        new org.apache.river.start.NonActivatableServiceDescriptor(
            /* exportCodebase: URL from which clients download the proxy JAR */
            "httpmd://" + System.getenv().getOrDefault("JGDMS_CODEBASE_HOST",
                System.getProperty("java.rmi.server.hostname", "localhost"))
            + ":" + System.getenv().getOrDefault("JGDMS_CODEBASE_PORT", "9080")
            + "/reggie-dl-" + System.getenv().getOrDefault("JGDMS_VERSION", "3.1.1-SNAPSHOT") + ".jar",

            /* policyFile */
            "/opt/jgdms/policy/host1-lookup.policy",

            /* classpath: service implementation JARs */
            "/opt/jgdms/lib/reggie-service-" + System.getenv().getOrDefault("JGDMS_VERSION","3.1.1-SNAPSHOT") + ".jar"
            + java.io.File.pathSeparator + "/opt/jgdms/lib/*",

            /* implClass */
            "com.sun.jini.reggie.RegistrarImpl",

            /* serverConfigArgs: passed as String[] to the service constructor */
            new String[]{ "/opt/jgdms/config/host1-lookup.config" },

            /* lifeCycle */
            null
        )
    };
}

/*
 * Reggie-specific configuration component.
 * Reggie reads this component when it constructs itself.
 */
com.sun.jini.reggie {

    /* Use SSL/TLS JERI endpoint backed by SPIRE SVID */
    serverEndpoint = SslServerEndpoint.getInstance(
        System.getenv().getOrDefault("JGDMS_LOOKUP_HOST",
            System.getProperty("java.rmi.server.hostname", "0.0.0.0")),
        Integer.parseInt(System.getenv().getOrDefault("JGDMS_LOOKUP_PORT", "4160"))
    );

    exporter = new BasicJeriExporter(serverEndpoint, new BasicILFactory(), false, true);

    /* Unicast-only: disable multicast in Kubernetes */
    multicastInterfaces = new java.net.NetworkInterface[0];
    multicastAnnouncementInterval = Long.MAX_VALUE;
    unicastDiscoveryConstraints = new net.jini.core.constraint.MethodConstraints() {
        public net.jini.core.constraint.InvocationConstraints getConstraints(java.lang.reflect.Method m) {
            return net.jini.core.constraint.InvocationConstraints.EMPTY;
        }
        public java.util.Iterator iterator() { return java.util.Collections.emptyIterator(); }
    };

    /* Persistent state log directory */
    logDir = System.getenv().getOrDefault("JGDMS_LOG_DIR", "/opt/jgdms/log");

    /* Initial lookup locators (Reggie registers with itself) */
    initialLookupLocators = new LookupLocator[0];

    /* Groups to join */
    initialLookupGroups = new String[]{
        System.getenv().getOrDefault("JGDMS_LOOKUP_GROUP", "jgdms")
    };

    listenerPreparer    = new BasicProxyPreparer();
    locatorPreparer     = new BasicProxyPreparer();
    registrarPreparer   = new BasicProxyPreparer();
}

/*
 * SpiffeCredentialManager configuration.
 * SslServerEndpointImpl reads the SVID from the SPIRE-written PEM files.
 */
net.jini.jeri.ssl {
    spireDir = System.getenv().getOrDefault("SPIRE_DIR", "/run/spire");
}
